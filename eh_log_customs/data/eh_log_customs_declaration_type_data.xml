<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Universally recognised declaration types. Country pack
            modules append authority-specific variants (Mirsal, FASAH,
            Bayan, etc.) without touching the engine.
        -->

        <record id="dt_import" model="eh.log.customs.declaration.type">
            <field name="code">IMP</field>
            <field name="name">Import Declaration</field>
            <field name="direction">import</field>
            <field name="sequence">10</field>
            <field name="requires_deferment" eval="True"/>
        </record>

        <record id="dt_export" model="eh.log.customs.declaration.type">
            <field name="code">EXP</field>
            <field name="name">Export Declaration</field>
            <field name="direction">export</field>
            <field name="sequence">20</field>
        </record>

        <record id="dt_transit" model="eh.log.customs.declaration.type">
            <field name="code">TRA</field>
            <field name="name">Transit Declaration</field>
            <field name="direction">transit</field>
            <field name="sequence">30</field>
        </record>

        <record id="dt_transfer" model="eh.log.customs.declaration.type">
            <field name="code">TRF</field>
            <field name="name">Transfer Declaration</field>
            <field name="direction">transfer</field>
            <field name="sequence">40</field>
        </record>

        <record id="dt_re_export" model="eh.log.customs.declaration.type">
            <field name="code">REX</field>
            <field name="name">Re-export Declaration</field>
            <field name="direction">re_export</field>
            <field name="sequence">50</field>
        </record>

        <record id="dt_temporary" model="eh.log.customs.declaration.type">
            <field name="code">TADM</field>
            <field name="name">Temporary Admission</field>
            <field name="direction">temporary</field>
            <field name="sequence">60</field>
        </record>

    </data>
</odoo>
