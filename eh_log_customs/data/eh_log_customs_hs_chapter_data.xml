<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            HS chapter-level seed (2-digit codes). The 21 chapters
            of HS section IV (Prepared foodstuffs ...), IX (Wood ...),
            XI (Textiles ...), XV (Base metals), XVI (Machinery and
            electrical), XVII (Vehicles), and a few others most-used
            in GCC trade. The full 96 chapters are added by country
            packs that ship national tariff overlays alongside.

            Heading-, subheading-, and national-level codes ship in
            country localisation packs (eh_log_l10n_ae_customs etc.)
            because duty rates are country-specific.
        -->

        <record id="hs_ch_01" model="eh.log.customs.hs.code">
            <field name="code">01</field>
