<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_customs_declaration_type_list" model="ir.ui.view">
            <field name="name">eh.log.customs.declaration.type.list</field>
            <field name="model">eh.log.customs.declaration.type</field>
            <field name="arch" type="xml">
                <list string="Declaration Types">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="direction"/>
                    <field name="country_id" optional="show"/>
                    <field name="requires_deferment" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_customs_declaration_type_form" model="ir.ui.view">
            <field name="name">eh.log.customs.declaration.type.form</field>
            <field name="model">eh.log.customs.declaration.type</field>
            <field name="arch" type="xml">
                <form string="Declaration Type">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h1>
                                <field name="code" placeholder="IMP"/>
                            </h1>
                            <field name="name" placeholder="Import Declaration"/>
                        </div>
                        <group>
                            <group>
                                <field name="direction"/>
                                <field name="country_id" options="{'no_create': True}"/>
                                <field name="requires_deferment"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eh_log_customs_declaration_type" model="ir.actions.act_window">
            <field name="name">Declaration Types</field>
            <field name="res_model">eh.log.customs.declaration.type</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
