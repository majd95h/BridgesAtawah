#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_run.py:0
msgid ""
"[EHL-COLD-CHAIN-001] State changes on a cold chain run must go through the "
"action buttons. Direct writes are rejected."
msgstr ""
"[EHL-COLD-CHAIN-001] Los cambios de estado en un recorrido de cadena de frío"
" deben realizarse mediante los botones de acción. Las escrituras directas se"
" rechazan."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_run.py:0
msgid ""
"[EHL-COLD-CHAIN-002] Cold chain run %(name)s is in state %(state)s. Readings"
" can only be ingested while the run is active."
msgstr ""
"[EHL-COLD-CHAIN-002] El recorrido de cadena de frío %(name)s está en el "
"estado %(state)s. Las lecturas solo pueden ingerirse mientras el recorrido "
"está activo."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-001] State changes on a cold chain deviation must go "
"through the action buttons. Direct writes are rejected."
msgstr ""
"[EHL-COLD-CHAIN-DEV-001] Los cambios de estado en una desviación de cadena "
"de frío deben realizarse mediante los botones de acción. Las escrituras "
"directas se rechazan."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-002] Deviation %(name)s cannot be resolved without a "
"cause classification."
msgstr ""
"[EHL-COLD-CHAIN-DEV-002] La desviación %(name)s no puede resolverse sin una "
"clasificación de la causa."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-003] Voiding deviation %(name)s requires a justification"
" in the resolution notes."
msgstr ""
"[EHL-COLD-CHAIN-DEV-003] La anulación de la desviación %(name)s requiere una"
" justificación en las notas de resolución."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_reading.py:0
msgid ""
"[EHL-COLD-CHAIN-READING-001] Cold chain readings are append-only. The "
"following fields cannot be edited after capture: %(fields)s."
msgstr ""
"[EHL-COLD-CHAIN-READING-001] Las lecturas de cadena de frío son solo de "
"anexado. Los siguientes campos no pueden editarse después de la captura: "
"%(fields)s."

