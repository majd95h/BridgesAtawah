#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_run.py:0
msgid ""
"[EHL-COLD-CHAIN-001] State changes on a cold chain run must go through the "
"action buttons. Direct writes are rejected."
msgstr ""
"[EHL-COLD-CHAIN-001] Les changements d'état sur un trajet de chaîne du froid"
" doivent passer par les boutons d'action. Les écritures directes sont "
"rejetées."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_run.py:0
msgid ""
"[EHL-COLD-CHAIN-002] Cold chain run %(name)s is in state %(state)s. Readings"
" can only be ingested while the run is active."
msgstr ""
"[EHL-COLD-CHAIN-002] Le trajet de chaîne du froid %(name)s est à l'état "
"%(state)s. Les relevés ne peuvent être ingérés que lorsque le trajet est "
"actif."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-001] State changes on a cold chain deviation must go "
"through the action buttons. Direct writes are rejected."
msgstr ""
"[EHL-COLD-CHAIN-DEV-001] Les changements d'état sur une déviation de chaîne "
"du froid doivent passer par les boutons d'action. Les écritures directes "
"sont rejetées."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-002] Deviation %(name)s cannot be resolved without a "
"cause classification."
msgstr ""
"[EHL-COLD-CHAIN-DEV-002] La déviation %(name)s ne peut pas être résolue sans"
" une classification de la cause."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-003] Voiding deviation %(name)s requires a justification"
" in the resolution notes."
msgstr ""
"[EHL-COLD-CHAIN-DEV-003] L'annulation de la déviation %(name)s nécessite une"
" justification dans les notes de résolution."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_reading.py:0
