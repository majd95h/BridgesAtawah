#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_run.py:0
msgid ""
"[EHL-COLD-CHAIN-001] State changes on a cold chain run must go through the "
"action buttons. Direct writes are rejected."
msgstr ""
"[EHL-COLD-CHAIN-001] Изменения состояния рейса холодовой цепи должны "
"выполняться через кнопки действий. Прямая запись отклоняется."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_run.py:0
msgid ""
"[EHL-COLD-CHAIN-002] Cold chain run %(name)s is in state %(state)s. Readings"
" can only be ingested while the run is active."
msgstr ""
"[EHL-COLD-CHAIN-002] Рейс холодовой цепи %(name)s находится в состоянии "
"%(state)s. Показания можно принимать только пока рейс активен."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-001] State changes on a cold chain deviation must go "
"through the action buttons. Direct writes are rejected."
msgstr ""
"[EHL-COLD-CHAIN-DEV-001] Изменения состояния отклонения холодовой цепи "
"должны выполняться через кнопки действий. Прямая запись отклоняется."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-002] Deviation %(name)s cannot be resolved without a "
"cause classification."
msgstr ""
"[EHL-COLD-CHAIN-DEV-002] Отклонение %(name)s не может быть устранено без "
"классификации причины."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_deviation.py:0
msgid ""
"[EHL-COLD-CHAIN-DEV-003] Voiding deviation %(name)s requires a justification"
" in the resolution notes."
msgstr ""
"[EHL-COLD-CHAIN-DEV-003] Аннулирование отклонения %(name)s требует "
"обоснования в примечаниях к устранению."

#. module: eh_log_cold_chain
#. odoo-python
#: code:addons/eh_log_cold_chain/models/eh_log_cold_chain_reading.py:0
msgid ""
"[EHL-COLD-CHAIN-READING-001] Cold chain readings are append-only. The "
"following fields cannot be edited after capture: %(fields)s."
msgstr ""
"[EHL-COLD-CHAIN-READING-001] Показания холодовой цепи доступны только для "
"добавления. Следующие поля нельзя редактировать после фиксации: %(fields)s."

