<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_cold_chain_deviation_list" model="ir.ui.view">
            <field name="name">eh.log.cold.chain.deviation.list</field>
            <field name="model">eh.log.cold.chain.deviation</field>
            <field name="arch" type="xml">
                <list string="Deviations" decoration-warning="state == 'open'" decoration-info="state == 'acknowledged'" decoration-success="state == 'resolved'" decoration-muted="state == 'voided'" decoration-danger="cargo_impacting and state != 'voided'">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="run_id"/>
                    <field name="deviation_kind"/>
                    <field name="started_at"/>
                    <field name="ended_at"/>
                    <field name="duration_minutes"/>
                    <field name="min_temperature"/>
                    <field name="max_temperature"/>
                    <field name="cargo_impacting"/>
                    <field name="cause" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_cold_chain_deviation_form" model="ir.ui.view">
            <field name="name">eh.log.cold.chain.deviation.form</field>
            <field name="model">eh.log.cold.chain.deviation</field>
            <field name="arch" type="xml">
                <form string="Deviation">
                    <header>
                        <button name="action_acknowledge" string="Acknowledge" type="object" class="btn-primary" invisible="state != 'open'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_mark_cargo_impacting" string="Mark Cargo Impacting" type="object" class="btn-secondary" invisible="cargo_impacting or state == 'voided'" groups="eh_log_base.group_eh_log_manager"/>
                        <button name="action_resolve" string="Resolve" type="object" class="btn-primary" invisible="state != 'acknowledged'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_void" string="Void (False Alarm)" type="object" class="btn-secondary" invisible="state in ('resolved', 'voided')" groups="eh_log_base.group_eh_log_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="open,acknowledged,resolved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Window">
                                <field name="run_id" options="{'no_create': True}" readonly="1"/>
                                <field name="deviation_kind" readonly="1"/>
                                <field name="started_at" readonly="1"/>
                                <field name="ended_at" readonly="1"/>
                                <field name="duration_minutes" readonly="1"/>
                            </group>
                            <group string="Magnitude">
                                <field name="min_temperature" readonly="1"/>
                                <field name="max_temperature" readonly="1"/>
                                <field name="cargo_impacting"/>
                            </group>
                        </group>
                        <group string="Cause and Resolution">
                            <field name="cause"/>
                            <field name="resolution_notes" colspan="2"/>
                        </group>
                        <group string="Audit">
                            <group>
                                <field name="acknowledged_by_id" readonly="1"/>
                                <field name="acknowledged_at" readonly="1"/>
                            </group>
                            <group>
                                <field name="resolved_by_id" readonly="1"/>
                                <field name="resolved_at" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eh_log_cold_chain_deviation" model="ir.actions.act_window">
            <field name="name">Cold Chain Deviations</field>
            <field name="res_model">eh.log.cold.chain.deviation</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
