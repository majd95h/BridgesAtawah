<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_cold_chain_reading_list" model="ir.ui.view">
            <field name="name">eh.log.cold.chain.reading.list</field>
            <field name="model">eh.log.cold.chain.reading</field>
            <field name="arch" type="xml">
                <list string="Readings" decoration-danger="is_breach">
                    <field name="captured_at"/>
                    <field name="run_id"/>
                    <field name="temperature"/>
                    <field name="humidity" optional="show"/>
                    <field name="source"/>
                    <field name="sensor_reference" optional="show"/>
                    <field name="is_breach"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_cold_chain_reading_form" model="ir.ui.view">
            <field name="name">eh.log.cold.chain.reading.form</field>
            <field name="model">eh.log.cold.chain.reading</field>
            <field name="arch" type="xml">
                <form string="Reading">
                    <sheet>
                        <group>
                            <group>
                                <field name="run_id" options="{'no_create': True}"/>
                                <field name="captured_at"/>
                                <field name="temperature"/>
                                <field name="humidity"/>
                            </group>
                            <group>
                                <field name="source"/>
                                <field name="sensor_reference"/>
                                <field name="is_breach" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eh_log_cold_chain_reading" model="ir.actions.act_window">
            <field name="name">Cold Chain Readings</field>
            <field name="res_model">eh.log.cold.chain.reading</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
