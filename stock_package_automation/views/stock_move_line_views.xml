<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit stock move line operations list -->
    <record id="view_stock_move_line_operation_tree_inherit_package" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit.package</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="auto_package_lot_created" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit stock move line tree -->
    <record id="view_stock_move_line_tree_inherit_package" model="ir.ui.view">
        <field name="name">stock.move.line.list.inherit.package</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="result_package_id"/>
                <field name="lot_id"/>
                <field name="location_dest_id"/>
            </xpath>
        </field>
    </record>

</odoo>