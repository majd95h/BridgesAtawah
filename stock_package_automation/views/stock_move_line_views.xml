<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- تعديل نموذج stock.move.line لإضافة الحقول الجديدة -->
        <record id="view_stock_move_line_form" model="ir.ui.view">
            <field name="name">stock.move.line.form.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id">stock.view_move_line_form</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="auto_package_lot_created" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- قائمة مخصصة لـ stock.move.line مع التفاصيل الإضافية -->
        <record id="view_stock_move_line_tree_inherit" model="ir.ui.view">
            <field name="name">stock.move.line.tree.inherit</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id">stock.view_move_line_tree</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="result_package_id"/>
                    <field name="lot_id"/>
                    <field name="location_dest_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
