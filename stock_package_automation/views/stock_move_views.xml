<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit stock move form to add destination wizard button -->
    <record id="view_stock_move_form_inherit_package_automation" model="ir.ui.view">
        <field name="name">stock.move.form.inherit.package.automation</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button
                    name="%(stock_package_automation.action_stock_move_destination_wizard)d"
                    string="edit all destinations"
                    type="action"
                    class="btn-primary"
                    invisible="state != 'confirmed'"
                    context="{'active_id': id}"
                />
            </xpath>

        </field>
    </record>

</odoo>
