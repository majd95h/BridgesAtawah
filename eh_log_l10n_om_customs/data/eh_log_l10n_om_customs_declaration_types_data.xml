<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="dt_om_imp" model="eh.log.customs.declaration.type">
            <field name="code">OM-IMP</field>
            <field name="name">Import Declaration (Oman)</field>
            <field name="direction">import</field>
            <field name="country_id" ref="base.om"/>
            <field name="sequence">110</field>
            <field name="requires_deferment" eval="True"/>
        </record>

        <record id="dt_om_exp" model="eh.log.customs.declaration.type">
            <field name="code">OM-EXP</field>
            <field name="name">Export Declaration (Oman)</field>
            <field name="direction">export</field>
            <field name="country_id" ref="base.om"/>
            <field name="sequence">120</field>
        </record>

        <record id="dt_om_transit" model="eh.log.customs.declaration.type">
            <field name="code">OM-TRA</field>
            <field name="name">Transit Declaration (Oman)</field>
            <field name="direction">transit</field>
            <field name="country_id" ref="base.om"/>
            <field name="sequence">130</field>
        </record>

        <record id="dt_om_re_export" model="eh.log.customs.declaration.type">
            <field name="code">OM-REX</field>
            <field name="name">Re-export Declaration (Oman)</field>
            <field name="direction">re_export</field>
            <field name="country_id" ref="base.om"/>
            <field name="sequence">140</field>
        </record>

        <record id="dt_om_temp_admission" model="eh.log.customs.declaration.type">
            <field name="code">OM-TADM</field>
            <field name="name">Temporary Admission (Oman)</field>
            <field name="direction">temporary</field>
            <field name="country_id" ref="base.om"/>
            <field name="sequence">150</field>
        </record>

        <record id="dt_om_gcc" model="eh.log.customs.declaration.type">
            <field name="code">OM-GCC</field>
            <field name="name">GCC Inter-state Movement (Oman)</field>
            <field name="direction">transfer</field>
            <field name="country_id" ref="base.om"/>
            <field name="sequence">160</field>
        </record>

        <record id="dt_om_imp_fz" model="eh.log.customs.declaration.type">
            <field name="code">OM-IMP-FZ</field>
            <field name="name">Import to Free Zone or SEZ (Oman)</field>
            <field name="direction">import</field>
            <field name="country_id" ref="base.om"/>
            <field name="sequence">170</field>
        </record>

    </data>
</odoo>
