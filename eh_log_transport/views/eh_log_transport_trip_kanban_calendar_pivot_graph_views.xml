<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_transport_trip_kanban" model="ir.ui.view">
        <field name="name">eh.log.transport.trip.kanban.boards</field>
        <field name="model">eh.log.transport.trip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="pickup_planned_at"/>
                <field name="delivery_planned_at"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted small"><field name="customer_id"/></div>
                                <div class="mt-1">
                                    <i class="fa fa-truck me-1" title="Vehicle"/>
                                    <field name="vehicle_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-id-badge me-1" title="Driver"/>
                                    <field name="driver_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 small text-muted">
                                <div>Pickup: <field name="pickup_planned_at" widget="date"/></div>
                                <div>Delivery: <field name="delivery_planned_at" widget="date"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eh_log_transport_trip_calendar" model="ir.ui.view">
        <field name="name">eh.log.transport.trip.calendar</field>
        <field name="model">eh.log.transport.trip</field>
        <field name="arch" type="xml">
            <calendar string="Trips"
                      date_start="pickup_planned_at"
                      date_stop="delivery_planned_at"
                      color="state"
                      mode="week">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="driver_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_eh_log_transport_trip_pivot" model="ir.ui.view">
        <field name="name">eh.log.transport.trip.pivot</field>
        <field name="model">eh.log.transport.trip</field>
        <field name="arch" type="xml">
            <pivot string="Trip Volume Analysis" sample="1">
                <field name="customer_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_eh_log_transport_trip_graph" model="ir.ui.view">
        <field name="name">eh.log.transport.trip.graph</field>
        <field name="model">eh.log.transport.trip</field>
        <field name="arch" type="xml">
            <graph string="Trips by State" sample="1" type="bar">
                <field name="state"/>
            </graph>
        </field>
    </record>

</odoo>
