<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_transport_vehicle_list" model="ir.ui.view">
            <field name="name">eh.log.transport.vehicle.list</field>
            <field name="model">eh.log.transport.vehicle</field>
            <field name="arch" type="xml">
                <list string="Vehicles">
                    <field name="registration"/>
                    <field name="name"/>
                    <field name="vehicle_type"/>
                    <field name="capacity_payload_kg" optional="show"/>
                    <field name="capacity_volume_cbm" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_transport_vehicle_form" model="ir.ui.view">
            <field name="name">eh.log.transport.vehicle.form</field>
            <field name="model">eh.log.transport.vehicle</field>
            <field name="arch" type="xml">
                <form string="Vehicle">
                    <sheet>
                        <div class="oe_title">
                            <label for="registration"/>
                            <h1><field name="registration" placeholder="ABC-1234"/></h1>
                            <field name="name" placeholder="Volvo FH16 #3"/>
                        </div>
                        <group>
                            <group>
                                <field name="vehicle_type"/>
                                <field name="capacity_payload_kg"/>
                                <field name="capacity_volume_cbm"/>
                            </group>
                            <group>
                                <field name="home_depot_id" options="{'no_create': True}"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eh_log_transport_vehicle" model="ir.actions.act_window">
            <field name="name">Vehicles</field>
            <field name="res_model">eh.log.transport.vehicle</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
