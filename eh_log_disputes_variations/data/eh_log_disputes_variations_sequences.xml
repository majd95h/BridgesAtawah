<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <data>

        <record id="seq_eh_log_dispute" model="ir.sequence">
            <field name="name">Dispute</field>
            <field name="code">eh.log.dispute</field>
            <field name="prefix">DSP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_variation" model="ir.sequence">
            <field name="name">Variation</field>
            <field name="code">eh.log.variation</field>
            <field name="prefix">VAR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
