<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_sale_order_form_disputes_variations" model="ir.ui.view">
        <field name="name">sale.order.form.eh_log_disputes_variations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_disputes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-gavel">
                    <field name="eh_log_dispute_count" widget="statinfo" string="Disputes"/>
                </button>
                <button name="action_view_variations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-edit">
                    <field name="eh_log_variation_count" widget="statinfo" string="Variations"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
