<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_freight_job_form_disputes_variations" model="ir.ui.view">
        <field name="name">eh.log.freight.job.form.disputes_variations</field>
        <field name="model">eh.log.freight.job</field>
        <field name="inherit_id" ref="eh_log_freight.view_eh_log_freight_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_disputes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-gavel">
                    <field name="eh_log_dispute_count" widget="statinfo" string="Disputes"/>
                </button>
                <button name="action_view_variations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-edit">
                    <field name="eh_log_variation_count" widget="statinfo" string="Variations"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
