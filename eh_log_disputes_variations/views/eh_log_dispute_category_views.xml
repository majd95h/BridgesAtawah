<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_dispute_category_list" model="ir.ui.view">
        <field name="name">eh.log.dispute.category.list</field>
        <field name="model">eh.log.dispute.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="default_sla_days"/>
                <field name="requires_survey"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_dispute_category_form" model="ir.ui.view">
        <field name="name">eh.log.dispute.category.form</field>
        <field name="model">eh.log.dispute.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="default_sla_days"/>
                            <field name="requires_survey"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_dispute_category" model="ir.actions.act_window">
        <field name="name">Dispute Categories</field>
        <field name="res_model">eh.log.dispute.category</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
