<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_variation_list" model="ir.ui.view">
        <field name="name">eh.log.variation.list</field>
        <field name="model">eh.log.variation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subject"/>
                <field name="customer_id"/>
                <field name="source_display"/>
                <field name="sale_order_id"/>
                <field name="net_amount"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_variation_form" model="ir.ui.view">
        <field name="name">eh.log.variation.form</field>
        <field name="model">eh.log.variation</field>
        <field name="arch" type="xml">
            <form string="Variation">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_apply" string="Apply to Sale Order" type="object" class="btn-primary" invisible="state != 'approved'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_close" string="Close" type="object" class="btn-secondary" invisible="state != 'applied'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-warning" invisible="state not in ('submitted', 'approved')" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state != 'rejected'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('applied', 'closed', 'cancelled')" groups="eh_log_base.group_eh_log_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,applied,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="customer_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="source_display" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="net_amount" readonly="1"/>
                            <field name="currency_id"/>
                            <field name="submitted_at" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="applied_at" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'rejected')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Applied Sale Order Lines" name="applied_lines" invisible="state not in ('applied', 'closed')">
                            <field name="applied_line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eh_log_variation" model="ir.actions.act_window">
        <field name="name">Variations</field>
        <field name="res_model">eh.log.variation</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
