<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form_disputes_variations" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.eh_log_disputes_variations</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ERP Heritage Disputes and Variations"
                     string="ERP Heritage Disputes and Variations"
                     name="eh_log_disputes_variations">
                    <block title="Approval Workflow" name="approval_block">
                        <setting id="variation_approval_limit"
                                 string="Variation Approval Limit"
                                 help="Net amount above which variation approval requires the manager group.">
                            <field name="eh_log_variation_approval_limit"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
