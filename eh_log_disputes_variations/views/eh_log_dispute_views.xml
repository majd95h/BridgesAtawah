<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_dispute_list" model="ir.ui.view">
        <field name="name">eh.log.dispute.list</field>
        <field name="model">eh.log.dispute</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="subject"/>
                <field name="customer_id"/>
                <field name="category_id"/>
                <field name="source_display"/>
                <field name="claimed_amount"/>
                <field name="exposure"/>
                <field name="sla_target_date"/>
                <field name="is_overdue" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_dispute_form" model="ir.ui.view">
        <field name="name">eh.log.dispute.form</field>
        <field name="model">eh.log.dispute</field>
        <field name="arch" type="xml">
            <form string="Dispute">
                <header>
                    <button name="action_start_investigation" string="Start Investigation" type="object" class="btn-primary" invisible="state != 'opened'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_make_offer" string="Tender Offer" type="object" class="btn-primary" invisible="state != 'investigating'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_accept_offer" string="Mark Accepted" type="object" class="btn-primary" invisible="state != 'offered'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_settle" string="Mark Settled" type="object" class="btn-primary" invisible="state != 'accepted'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-warning" invisible="state not in ('investigating', 'offered', 'escalated')" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_escalate" string="Escalate" type="object" class="btn-warning" invisible="state not in ('investigating', 'offered', 'rejected')" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_write_off" string="Write Off" type="object" class="btn-secondary" invisible="state != 'escalated'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_close" string="Close" type="object" class="btn-secondary" invisible="state not in ('settled', 'rejected', 'escalated', 'written_off')" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('closed', 'cancelled')" groups="eh_log_base.group_eh_log_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="opened,investigating,offered,settled,closed"/>
                </header>
                <sheet>
                    <field name="is_overdue" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_source_record"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-link">
                            <span class="o_stat_text">Source Record</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <div invisible="not is_overdue" class="alert alert-danger" role="alert">
                        <strong>Overdue.</strong>
                        SLA target was <field name="sla_target_date" readonly="1"/>.
                    </div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="customer_id"/>
                            <field name="opened_at" readonly="1"/>
                            <field name="sla_target_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="source_display" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Financials">
                        <group>
                            <field name="claimed_amount"/>
                            <field name="offered_amount"/>
                            <field name="settled_amount"/>
                        </group>
                        <group>
                            <field name="exposure" readonly="1"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Event Log" name="events">
                            <field name="event_ids" readonly="1">
                                <list>
                                    <field name="occurred_at"/>
                                    <field name="event_type"/>
                                    <field name="summary"/>
                                    <field name="from_state"/>
                                    <field name="to_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eh_log_dispute_search" model="ir.ui.view">
        <field name="name">eh.log.dispute.search</field>
        <field name="model">eh.log.dispute</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="customer_id"/>
                <field name="category_id"/>
                <filter name="filter_open" string="Open"
                        domain="[('state', 'not in', ('closed', 'cancelled', 'settled', 'written_off'))]"/>
                <filter name="filter_settled" string="Settled" domain="[('state', '=', 'settled')]"/>
                <group>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

        <record id="view_dispute_activity" model="ir.ui.view">
            <field name="name">eh.log.dispute.activity</field>
            <field name="model">eh.log.dispute</field>
            <field name="arch" type="xml">
                <activity string="Activities">
                    <templates>
                        <div t-name="activity-box">
                            <field name="name" display="full"/>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

    <record id="action_eh_log_dispute" model="ir.actions.act_window">
        <field name="name">Disputes</field>
        <field name="res_model">eh.log.dispute</field>
        <field name="view_mode">list,activity,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>

</odoo>
