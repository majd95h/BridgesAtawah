msgstr "[EHL-DSP-004] Rekaman sumber %(model)s/%(id)s tidak ada."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-005] Offered amount %(offered)s exceeds claimed amount %(claimed)s "
"for dispute %(name)s."
msgstr ""
"[EHL-DSP-005] Jumlah yang ditawarkan %(offered)s melebihi jumlah yang "
"diklaim %(claimed)s untuk sengketa %(name)s."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-006] Cannot tender an offer for dispute %(name)s without an offered"
" amount."
msgstr ""
"[EHL-DSP-006] Tidak dapat mengajukan penawaran untuk sengketa %(name)s tanpa"
" jumlah yang ditawarkan."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-007] Cannot mark dispute %(name)s settled without a settled amount."
msgstr ""
"[EHL-DSP-007] Tidak dapat menandai sengketa %(name)s sebagai selesai tanpa "
"jumlah penyelesaian."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-008] Dispute state must change via the action methods, not by "
"direct write."
msgstr ""
"[EHL-DSP-008] Status sengketa harus diubah melalui metode tindakan, bukan "
"dengan penulisan langsung."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-009] Dispute events are created by the dispute's action methods or "
"_log_event helper, not by direct ORM write."
msgstr ""
"[EHL-DSP-009] Peristiwa sengketa dibuat oleh metode tindakan sengketa atau "
"pembantu _log_event, bukan dengan penulisan ORM langsung."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-010] Dispute event field(s) %(fields)s are immutable after "
"creation. Append a new event instead."
msgstr ""
"[EHL-DSP-010] Bidang peristiwa sengketa %(fields)s tidak dapat diubah "
"setelah dibuat. Tambahkan peristiwa baru sebagai gantinya."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid "[EHL-DSP-011] Dispute events are append-only and cannot be deleted."
msgstr ""
"[EHL-DSP-011] Peristiwa sengketa hanya dapat ditambahkan dan tidak dapat "
"dihapus."

