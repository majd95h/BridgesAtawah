"[EHL-VAR-004] Variation %(name)s has no linked sale order; cannot apply."
msgstr ""
"[EHL-VAR-004] Variasi %(name)s tidak memiliki pesanan penjualan tertaut; "
"tidak dapat diterapkan."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid "[EHL-VAR-005] Variation state must change via the action methods."
msgstr "[EHL-VAR-005] Status variasi harus diubah melalui metode tindakan."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
