#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute_category.py:0
msgid ""
"[EHL-DSP-001] Seeded dispute category %(code)s cannot be renamed; create a "
"new category instead."
msgstr "[EHL-DSP-001] 初期設定の紛争カテゴリ %(code)s は名前を変更できません。代わりに新しいカテゴリを作成してください。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute_category.py:0
msgid ""
"[EHL-DSP-002] Seeded dispute category %(code)s cannot be deleted; archive it"
" instead."
msgstr "[EHL-DSP-002] 初期設定の紛争カテゴリ %(code)s は削除できません。代わりにアーカイブしてください。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-003] Source model %(model)s is not in the dispute allow-list. "
"Permitted: %(list)s"
msgstr "[EHL-DSP-003] ソースモデル %(model)s は紛争の許可リストにありません。許可: %(list)s"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid "[EHL-DSP-004] Source record %(model)s/%(id)s does not exist."
msgstr "[EHL-DSP-004] ソースレコード %(model)s/%(id)s は存在しません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-005] Offered amount %(offered)s exceeds claimed amount %(claimed)s "
"for dispute %(name)s."
msgstr "[EHL-DSP-005] 提示額 %(offered)s は、紛争 %(name)s の請求額 %(claimed)s を超えています。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-006] Cannot tender an offer for dispute %(name)s without an offered"
" amount."
msgstr "[EHL-DSP-006] 提示額なしでは紛争 %(name)s へのオファーを提示できません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-007] Cannot mark dispute %(name)s settled without a settled amount."
msgstr "[EHL-DSP-007] 和解額なしでは紛争 %(name)s を和解済みとしてマークできません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-008] Dispute state must change via the action methods, not by "
"direct write."
msgstr "[EHL-DSP-008] 紛争の状態は、直接の書き込みではなくアクションメソッドを介して変更する必要があります。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-009] Dispute events are created by the dispute's action methods or "
"_log_event helper, not by direct ORM write."
msgstr ""
"[EHL-DSP-009] 紛争イベントは、紛争のアクションメソッドまたは _log_event ヘルパーによって作成され、直接の ORM "
"書き込みでは作成されません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-010] Dispute event field(s) %(fields)s are immutable after "
"creation. Append a new event instead."
msgstr ""
"[EHL-DSP-010] 紛争イベントフィールド %(fields)s は作成後は変更できません。代わりに新しいイベントを追加してください。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid "[EHL-DSP-011] Dispute events are append-only and cannot be deleted."
msgstr "[EHL-DSP-011] 紛争イベントは追加のみ可能で、削除できません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid ""
"[EHL-VAR-001] Source model %(model)s is not in the variation allow-list."
msgstr "[EHL-VAR-001] ソースモデル %(model)s はバリエーションの許可リストにありません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid "[EHL-VAR-002] Source record %(model)s/%(id)s does not exist."
msgstr "[EHL-VAR-002] ソースレコード %(model)s/%(id)s が存在しません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid ""
"[EHL-VAR-003] Variation %(name)s has no lines; add at least one before "
"submitting."
msgstr "[EHL-VAR-003] バリエーション %(name)s に明細行がありません。送信する前に少なくとも1行追加してください。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid ""
"[EHL-VAR-004] Variation %(name)s has no linked sale order; cannot apply."
msgstr "[EHL-VAR-004] バリエーション %(name)s にリンクされた販売注文がありません。適用できません。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid "[EHL-VAR-005] Variation state must change via the action methods."
msgstr "[EHL-VAR-005] バリエーションの状態はアクションメソッドで変更する必要があります。"

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid "[EHL-VAR-006] Variation %(name)s is %(state)s; lines are read-only."
msgstr "[EHL-VAR-006] バリエーション %(name)s は %(state)s です。明細行は読み取り専用です。"

