msgstr "[EHL-DSP-004] Исходная запись %(model)s/%(id)s не существует."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-005] Offered amount %(offered)s exceeds claimed amount %(claimed)s "
"for dispute %(name)s."
msgstr ""
"[EHL-DSP-005] Предложенная сумма %(offered)s превышает заявленную сумму "
"%(claimed)s по спору %(name)s."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-006] Cannot tender an offer for dispute %(name)s without an offered"
" amount."
msgstr ""
"[EHL-DSP-006] Невозможно предложить оферту по спору %(name)s без указания "
"предложенной суммы."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-007] Cannot mark dispute %(name)s settled without a settled amount."
msgstr ""
"[EHL-DSP-007] Невозможно отметить спор %(name)s как урегулированный без "
"указания суммы урегулирования."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-008] Dispute state must change via the action methods, not by "
"direct write."
msgstr ""
"[EHL-DSP-008] Состояние спора должно изменяться через методы действий, а не "
"прямой записью."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-009] Dispute events are created by the dispute's action methods or "
"_log_event helper, not by direct ORM write."
msgstr ""
"[EHL-DSP-009] События спора создаются методами действий спора или "
"вспомогательной функцией _log_event, а не прямой записью через ORM."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid ""
"[EHL-DSP-010] Dispute event field(s) %(fields)s are immutable after "
"creation. Append a new event instead."
msgstr ""
"[EHL-DSP-010] Поля события спора %(fields)s неизменяемы после создания. "
"Вместо этого добавьте новое событие."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_dispute.py:0
msgid "[EHL-DSP-011] Dispute events are append-only and cannot be deleted."
msgstr ""
"[EHL-DSP-011] События спора доступны только для добавления и не могут быть "
"удалены."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
msgid ""
"[EHL-VAR-001] Source model %(model)s is not in the variation allow-list."
msgstr ""
"[EHL-VAR-001] Исходная модель %(model)s отсутствует в списке разрешённых для"
" вариаций."

#. module: eh_log_disputes_variations
#. odoo-python
#: code:addons/eh_log_disputes_variations/models/eh_log_variation.py:0
