            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_log_dispute_event_company" model="ir.rule">
            <field name="name">eh.log.dispute.event: company isolation</field>
            <field name="model_id" ref="model_eh_log_dispute_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_log_variation_company" model="ir.rule">
            <field name="name">eh.log.variation: company isolation</field>
            <field name="model_id" ref="model_eh_log_variation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
