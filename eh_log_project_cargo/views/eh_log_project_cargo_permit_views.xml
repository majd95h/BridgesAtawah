<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_project_cargo_permit_list" model="ir.ui.view">
        <field name="name">eh.log.project.cargo.permit.list</field>
        <field name="model">eh.log.project.cargo.permit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_id"/>
                <field name="authority"/>
                <field name="permit_reference"/>
                <field name="valid_until"/>
                <field name="days_until_expiry"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_project_cargo_permit_form" model="ir.ui.view">
        <field name="name">eh.log.project.cargo.permit.form</field>
        <field name="model">eh.log.project.cargo.permit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" string="Mark Applied" type="object" class="btn-primary" invisible="state != 'draft'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_mark_issued" string="Mark Issued" type="object" class="btn-primary" invisible="state != 'applied'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'issued'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_close" string="Close" type="object" class="btn-secondary" invisible="state != 'active'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_mark_rejected" string="Mark Rejected" type="object" class="btn-warning" invisible="state != 'applied'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('closed', 'cancelled')" groups="eh_log_base.group_eh_log_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied,issued,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id" options="{'no_create': True}"/>
                            <field name="convoy_id" options="{'no_create': True}"/>
                            <field name="authority"/>
                            <field name="issuing_partner_id"/>
                            <field name="permit_reference"/>
                        </group>
                        <group>
                            <field name="applied_at"/>
                            <field name="issued_at"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                            <field name="days_until_expiry" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="cost_amount"/>
                        <field name="currency_id"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eh_log_project_cargo_permit" model="ir.actions.act_window">
        <field name="name">Permits</field>
        <field name="res_model">eh.log.project.cargo.permit</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
