<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_report_method_statement" model="ir.actions.report">
        <field name="name">Method Statement</field>
        <field name="model">eh.log.project.cargo.job</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eh_log_project_cargo.report_method_statement_document</field>
        <field name="report_file">eh_log_project_cargo.report_method_statement_document</field>
        <field name="binding_model_id" ref="model_eh_log_project_cargo_job"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="eh_log_base.paperformat_eh_log_portrait"/>
    </record>

    <template id="report_method_statement_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="job">
                <t t-call="eh_log_base.eh_log_clean_layout">
                    <t t-set="company" t-value="job.company_id"/>
                    <t t-set="report_type" t-value="'pdf'"/>
                    <t t-call="eh_log_base.eh_log_report_styles"/>
                    <div class="page eh_pdf_page">
                        <t t-call="eh_log_base.eh_log_report_header">
                            <t t-set="title" t-value="'Method Statement'"/>
                            <t t-set="company" t-value="job.company_id"/>
                        </t>

                        <div class="eh_pdf_meta">
                            <span><strong>Reference:</strong> <t t-out="job.name"/></span>
                            <span><strong>Customer:</strong> <t t-out="job.customer_partner_id.display_name"/></span>
                            <span><strong>Project:</strong> <t t-out="job.project_name or ''"/></span>
                            <span><strong>Origin:</strong> <t t-out="job.origin_partner_id.display_name or ''"/></span>
                            <span><strong>Destination:</strong> <t t-out="job.destination_partner_id.display_name or ''"/></span>
                        </div>

                        <h2 class="eh_pdf_subtitle">Items</h2>
                        <table class="eh_pdf_table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">L (m)</th>
                                    <th class="text-end">W (m)</th>
                                    <th class="text-end">H (m)</th>
                                    <th class="text-end">Weight (t)</th>
                                    <th>Oversized</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="job.item_ids" t-as="item">
                                    <td><t t-out="item.name"/></td>
                                    <td class="text-end"><t t-out="item.quantity"/></td>
                                    <td class="text-end"><t t-out="'{:.2f}'.format(item.length_m)"/></td>
                                    <td class="text-end"><t t-out="'{:.2f}'.format(item.width_m)"/></td>
                                    <td class="text-end"><t t-out="'{:.2f}'.format(item.height_m)"/></td>
                                    <td class="text-end"><t t-out="'{:.2f}'.format(item.weight_t)"/></td>
                                    <td><t t-out="item.is_oversized and 'Yes' or 'No'"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h2 class="eh_pdf_subtitle">Statement</h2>
                        <div t-out="job.method_statement"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
