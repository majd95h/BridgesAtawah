msgstr "[EHL-PCG-007] %(label)s del artículo %(name)s no puede ser negativo."

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_convoy.py:0
