"%(permits)s"
msgstr ""
"[EHL-PCG-005] Il lavoro %(name)s ha permessi non in stato rilasciato / "
"attivo: %(permits)s"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
