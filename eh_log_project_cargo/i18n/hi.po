#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_equipment.py:0
msgid "[EHL-PCG-001] Equipment %(code)s rated capacity must be positive."
msgstr "[EHL-PCG-001] उपकरण %(code)s की रेटेड क्षमता धनात्मक होनी चाहिए।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-002] Job %(name)s cannot move to Surveyed without at least one "
"route survey."
msgstr ""
"[EHL-PCG-002] कम से कम एक मार्ग सर्वेक्षण के बिना कार्य %(name)s को "
"सर्वेक्षित स्थिति में नहीं ले जाया जा सकता।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-003] Job %(name)s cannot move to Planned without at least one "
"convoy."
msgstr ""
"[EHL-PCG-003] कम से कम एक काफिले के बिना कार्य %(name)s को नियोजित स्थिति "
"में नहीं ले जाया जा सकता।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid "[EHL-PCG-004] Convoy %(name)s has no vehicle assignments."
msgstr "[EHL-PCG-004] काफिले %(name)s में कोई वाहन असाइनमेंट नहीं है।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-005] Job %(name)s has permits not in issued / active state: "
"%(permits)s"
msgstr ""
"[EHL-PCG-005] कार्य %(name)s में ऐसे परमिट हैं जो जारी / सक्रिय स्थिति में "
"नहीं हैं: %(permits)s"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-006] Project-cargo job state must change via the action buttons."
msgstr ""
"[EHL-PCG-006] प्रोजेक्ट-कार्गो कार्य की स्थिति एक्शन बटन के माध्यम से बदली "
"जानी चाहिए।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_item.py:0
msgid "[EHL-PCG-007] Item %(name)s %(label)s cannot be negative."
msgstr "[EHL-PCG-007] आइटम %(name)s का %(label)s ऋणात्मक नहीं हो सकता।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_convoy.py:0
msgid ""
"[EHL-PCG-008] Convoy %(name)s scheduled arrival is before scheduled "
"departure."
msgstr ""
"[EHL-PCG-008] काफिले %(name)s का निर्धारित आगमन निर्धारित प्रस्थान से पहले "
"है।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_convoy.py:0
msgid "[EHL-PCG-009] Convoy %(name)s has no vehicles."
msgstr "[EHL-PCG-009] काफिले %(name)s में कोई वाहन नहीं है।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_convoy.py:0
msgid ""
"[EHL-PCG-010] Equipment %(code)s is overdue for statutory inspection (was "
"%(date)s); it cannot be assigned to a convoy until the inspection date is "
"updated."
msgstr ""
"[EHL-PCG-010] उपकरण %(code)s का वैधानिक निरीक्षण अतिदेय है (था %(date)s); जब"
" तक निरीक्षण तिथि अद्यतन नहीं की जाती, इसे किसी काफिले को नहीं सौंपा जा "
"सकता।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_permit.py:0
msgid ""
"[EHL-PCG-011] Permit %(name)s requires a valid-until date before it can be "
"marked issued."
msgstr ""
"[EHL-PCG-011] परमिट %(name)s को जारी के रूप में चिह्नित करने से पहले एक "
"वैधता-तिथि आवश्यक है।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_permit.py:0
msgid "[EHL-PCG-012] Permit state must change via the action buttons."
msgstr "[EHL-PCG-012] परमिट की स्थिति एक्शन बटन के माध्यम से बदली जानी चाहिए।"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_route_survey.py:0
msgid ""
"[EHL-PCG-013] Job %(name)s already has a chosen route survey; untick it "
"first."
msgstr ""
"[EHL-PCG-013] कार्य %(name)s में पहले से एक चयनित मार्ग सर्वेक्षण है; पहले "
"उसका टिक हटाएं।"

