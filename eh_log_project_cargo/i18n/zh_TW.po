#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_equipment.py:0
msgid "[EHL-PCG-001] Equipment %(code)s rated capacity must be positive."
msgstr "[EHL-PCG-001] 設備 %(code)s 的額定容量必須為正值。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-002] Job %(name)s cannot move to Surveyed without at least one "
"route survey."
msgstr "[EHL-PCG-002] 沒有至少一次路線勘測，作業 %(name)s 無法進入「已勘測」狀態。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-003] Job %(name)s cannot move to Planned without at least one "
"convoy."
msgstr "[EHL-PCG-003] 沒有至少一支車隊，作業 %(name)s 無法進入「已計劃」狀態。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid "[EHL-PCG-004] Convoy %(name)s has no vehicle assignments."
msgstr "[EHL-PCG-004] 車隊 %(name)s 沒有任何車輛指派。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-005] Job %(name)s has permits not in issued / active state: "
"%(permits)s"
msgstr "[EHL-PCG-005] 作業 %(name)s 存在未處於已核發/有效狀態的許可證：%(permits)s"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_job.py:0
msgid ""
"[EHL-PCG-006] Project-cargo job state must change via the action buttons."
msgstr "[EHL-PCG-006] 專案貨運作業狀態必須透過操作按鈕變更。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_item.py:0
msgid "[EHL-PCG-007] Item %(name)s %(label)s cannot be negative."
msgstr "[EHL-PCG-007] 項目 %(name)s 的 %(label)s 不能為負值。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_convoy.py:0
msgid ""
"[EHL-PCG-008] Convoy %(name)s scheduled arrival is before scheduled "
"departure."
msgstr "[EHL-PCG-008] 車隊 %(name)s 的計劃到達時間早於計劃出發時間。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_convoy.py:0
msgid "[EHL-PCG-009] Convoy %(name)s has no vehicles."
msgstr "[EHL-PCG-009] 車隊 %(name)s 沒有車輛。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_convoy.py:0
msgid ""
"[EHL-PCG-010] Equipment %(code)s is overdue for statutory inspection (was "
"%(date)s); it cannot be assigned to a convoy until the inspection date is "
"updated."
msgstr ""
"[EHL-PCG-010] 設備 %(code)s 已逾期未進行法定檢驗（原定 %(date)s）；在更新檢驗日期之前，無法將其指派給車隊。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_permit.py:0
msgid ""
"[EHL-PCG-011] Permit %(name)s requires a valid-until date before it can be "
"marked issued."
msgstr "[EHL-PCG-011] 許可證 %(name)s 需要設定有效期至日期後才能標記為已核發。"

#. module: eh_log_project_cargo
#. odoo-python
#: code:addons/eh_log_project_cargo/models/eh_log_project_cargo_permit.py:0
msgid "[EHL-PCG-012] Permit state must change via the action buttons."
msgstr "[EHL-PCG-012] 許可證狀態必須透過操作按鈕變更。"

