<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <data>

        <record id="seq_eh_log_project_cargo_job" model="ir.sequence">
            <field name="name">Project Cargo Job</field>
            <field name="code">eh.log.project.cargo.job</field>
            <field name="prefix">PCG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_project_cargo_convoy" model="ir.sequence">
            <field name="name">Project Cargo Convoy</field>
            <field name="code">eh.log.project.cargo.convoy</field>
            <field name="prefix">PCV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
