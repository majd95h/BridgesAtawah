msgstr "[EHL-TRK-001] Code d'événement de suivi %(code)s inconnu."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-002] Seeded tracking event code %(code)s cannot be renamed; create "
"a new code instead."
msgstr ""
"[EHL-TRK-002] Le code d'événement de suivi prédéfini %(code)s ne peut pas "
"être renommé ; créez plutôt un nouveau code."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-003] Seeded tracking event code %(code)s cannot be deleted; archive"
" it instead."
msgstr ""
"[EHL-TRK-003] Le code d'événement de suivi prédéfini %(code)s ne peut pas "
"être supprimé ; archivez-le plutôt."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-004] Tracking events must be created through log_track_event() on "
"the source record, not by direct ORM write."
msgstr ""
"[EHL-TRK-004] Les événements de suivi doivent être créés via "
"log_track_event() sur l'enregistrement source, et non par écriture ORM "
"directe."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-005] Tracking event field(s) %(fields)s are immutable after "
"creation. Add a new event instead."
msgstr ""
"[EHL-TRK-005] Le(s) champ(s) d'événement de suivi %(fields)s sont immuables "
"après création. Ajoutez plutôt un nouvel événement."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-006] Tracking events are append-only and cannot be deleted; archive"
" the source record instead."
msgstr ""
"[EHL-TRK-006] Les événements de suivi sont en ajout seul et ne peuvent pas "
"être supprimés ; archivez plutôt l'enregistrement source."

#. module: eh_log_track_trace
#. odoo-python
