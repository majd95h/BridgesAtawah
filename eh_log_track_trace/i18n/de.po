msgstr "[EHL-TRK-001] Unbekannter Tracking-Ereigniscode %(code)s."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-002] Seeded tracking event code %(code)s cannot be renamed; create "
"a new code instead."
msgstr ""
"[EHL-TRK-002] Der vorinstallierte Tracking-Ereigniscode %(code)s kann nicht "
"umbenannt werden; erstellen Sie stattdessen einen neuen Code."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-003] Seeded tracking event code %(code)s cannot be deleted; archive"
" it instead."
msgstr ""
"[EHL-TRK-003] Der vorinstallierte Tracking-Ereigniscode %(code)s kann nicht "
"gelöscht werden; archivieren Sie ihn stattdessen."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-004] Tracking events must be created through log_track_event() on "
"the source record, not by direct ORM write."
msgstr ""
"[EHL-TRK-004] Tracking-Ereignisse müssen über log_track_event() im "
"Quelldatensatz erstellt werden, nicht durch direktes ORM-Schreiben."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-005] Tracking event field(s) %(fields)s are immutable after "
"creation. Add a new event instead."
msgstr ""
"[EHL-TRK-005] Das/die Tracking-Ereignisfeld(er) %(fields)s ist/sind nach der"
" Erstellung unveränderlich. Fügen Sie stattdessen ein neues Ereignis hinzu."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-006] Tracking events are append-only and cannot be deleted; archive"
" the source record instead."
msgstr ""
"[EHL-TRK-006] Tracking-Ereignisse können nur angehängt und nicht gelöscht "
"werden; archivieren Sie stattdessen den Quelldatensatz."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_subscription.py:0
msgid "[EHL-TRK-007] Subscription source model %(model)s does not exist."
msgstr "[EHL-TRK-007] Das Abonnement-Quellmodell %(model)s existiert nicht."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_subscription.py:0
msgid ""
"[EHL-TRK-008] Source model %(model)s is not trackable; it must inherit "
"eh.log.track.trackable to be subscribed to."
msgstr ""
"[EHL-TRK-008] Das Quellmodell %(model)s ist nicht verfolgbar; es muss "
"eh.log.track.trackable erben, um abonniert werden zu können."

#. module: eh_log_track_trace
#. odoo-python
