"Where the event originated. The raw inbound body of a webhook event is kept "
"on the raw_payload field."
msgstr ""
"Dari mana peristiwa berasal. Isi masuk mentah dari peristiwa webhook "
"disimpan pada bidang raw_payload."

#. module: eh_log_track_trace
#: model:ir.model.fields,help:eh_log_track_trace.field_eh_log_track_webhook_endpoint__target_model
msgid ""
"Which trackable model the webhook posts events against. Most carrier "
"integrations target freight jobs; last-mile carriers target deliveries."
msgstr ""
"Model yang dapat dilacak mana yang menjadi tujuan webhook untuk mengirim "
"event. Sebagian besar integrasi pengangkut menargetkan pekerjaan angkutan; "
"pengangkut last-mile menargetkan pengiriman."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_trackable.py:0
msgid "[EHL-TRK-001] Unknown tracking event code %(code)s."
msgstr "[EHL-TRK-001] Kode peristiwa pelacakan %(code)s tidak dikenal."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-002] Seeded tracking event code %(code)s cannot be renamed; create "
"a new code instead."
msgstr ""
"[EHL-TRK-002] Kode peristiwa pelacakan bawaan %(code)s tidak dapat diganti "
"namanya; buat kode baru sebagai gantinya."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-003] Seeded tracking event code %(code)s cannot be deleted; archive"
" it instead."
msgstr ""
"[EHL-TRK-003] Kode peristiwa pelacakan bawaan %(code)s tidak dapat dihapus; "
"arsipkan sebagai gantinya."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-004] Tracking events must be created through log_track_event() on "
"the source record, not by direct ORM write."
msgstr ""
"[EHL-TRK-004] Peristiwa pelacakan harus dibuat melalui log_track_event() "
"pada catatan sumber, bukan dengan penulisan ORM langsung."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-005] Tracking event field(s) %(fields)s are immutable after "
"creation. Add a new event instead."
msgstr ""
"[EHL-TRK-005] Bidang peristiwa pelacakan %(fields)s tidak dapat diubah "
"setelah dibuat. Tambahkan peristiwa baru sebagai gantinya."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-006] Tracking events are append-only and cannot be deleted; archive"
" the source record instead."
msgstr ""
"[EHL-TRK-006] Peristiwa pelacakan hanya dapat ditambahkan dan tidak dapat "
"dihapus; arsipkan catatan sumber sebagai gantinya."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_subscription.py:0
msgid "[EHL-TRK-007] Subscription source model %(model)s does not exist."
msgstr "[EHL-TRK-007] Model sumber langganan %(model)s tidak ada."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_subscription.py:0
msgid ""
"[EHL-TRK-008] Source model %(model)s is not trackable; it must inherit "
"eh.log.track.trackable to be subscribed to."
msgstr ""
"[EHL-TRK-008] Model sumber %(model)s tidak dapat dilacak; harus mewarisi "
"eh.log.track.trackable agar dapat dilanggan."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_webhook_endpoint.py:0
msgid ""
"[EHL-TRK-009] Carrier name %(name)s must be alphanumeric or underscore only."
msgstr ""
"[EHL-TRK-009] Nama kurir %(name)s hanya boleh alfanumerik atau garis bawah."

#. module: eh_log_track_trace
