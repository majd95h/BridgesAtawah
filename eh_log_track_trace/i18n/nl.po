msgstr "[EHL-TRK-001] Onbekende trackinggebeurteniscode %(code)s."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-002] Seeded tracking event code %(code)s cannot be renamed; create "
"a new code instead."
msgstr ""
"[EHL-TRK-002] Vooraf ingestelde trackinggebeurteniscode %(code)s kan niet "
"worden hernoemd; maak in plaats daarvan een nieuwe code aan."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-003] Seeded tracking event code %(code)s cannot be deleted; archive"
" it instead."
msgstr ""
"[EHL-TRK-003] Vooraf ingestelde trackinggebeurteniscode %(code)s kan niet "
"worden verwijderd; archiveer deze in plaats daarvan."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-004] Tracking events must be created through log_track_event() on "
"the source record, not by direct ORM write."
msgstr ""
"[EHL-TRK-004] Trackinggebeurtenissen moeten worden aangemaakt via "
"log_track_event() op het bronrecord, niet door directe ORM-schrijfactie."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-005] Tracking event field(s) %(fields)s are immutable after "
"creation. Add a new event instead."
msgstr ""
"[EHL-TRK-005] Trackinggebeurtenisveld(en) %(fields)s zijn na aanmaak "
"onveranderlijk. Voeg in plaats daarvan een nieuwe gebeurtenis toe."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-006] Tracking events are append-only and cannot be deleted; archive"
" the source record instead."
msgstr ""
"[EHL-TRK-006] Trackinggebeurtenissen kunnen alleen worden toegevoegd en niet"
" worden verwijderd; archiveer in plaats daarvan het bronrecord."

#. module: eh_log_track_trace
#. odoo-python
