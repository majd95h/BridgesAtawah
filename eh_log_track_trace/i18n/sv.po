"<div class=\"eh-track-mail\">\n"
"                    <p>A new milestone was recorded for your shipment.</p>\n"
"                    <p>\n"
"                        <strong>\n"
"                            <t t-out=\"object.event_code_id.name or ''\"/>\n"
"                        </strong>\n"
"                    </p>\n"
"                    <p t-if=\"object.description\">\n"
"                        <t t-out=\"object.description\"/>\n"
"                    </p>\n"
"                    <p t-if=\"object.location\">\n"
"                        Location:\n"
"                        <t t-out=\"object.location\"/>\n"
"                    </p>\n"
"                    <p>\n"
"                        Recorded at:\n"
"                        <t t-out=\"object.occurred_at and object.occurred_at.strftime('%Y-%m-%d %H:%M') or ''\"/>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div class=\"eh-track-mail\">\n"
"                    <p>En ny milstolpe har registrerats för din sändning.</p>\n"
"                    <p>\n"
"                        <strong>\n"
"                            <t t-out=\"object.event_code_id.name or ''\"/>\n"
"                        </strong>\n"
"                    </p>\n"
"                    <p t-if=\"object.description\">\n"
"                        <t t-out=\"object.description\"/>\n"
"                    </p>\n"
"                    <p t-if=\"object.location\">\n"
"                        Plats:\n"
"                        <t t-out=\"object.location\"/>\n"
"                    </p>\n"
"                    <p>\n"
"                        Registrerad:\n"
"                        <t t-out=\"object.occurred_at and object.occurred_at.strftime('%Y-%m-%d %H:%M') or ''\"/>\n"
