#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-002] Seeded tracking event code %(code)s cannot be renamed; create "
"a new code instead."
msgstr ""
"[EHL-TRK-002] Wstępnie zdefiniowanego kodu zdarzenia śledzenia %(code)s nie "
"można zmienić; zamiast tego utwórz nowy kod."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event_code.py:0
msgid ""
"[EHL-TRK-003] Seeded tracking event code %(code)s cannot be deleted; archive"
" it instead."
msgstr ""
"[EHL-TRK-003] Wstępnie zdefiniowanego kodu zdarzenia śledzenia %(code)s nie "
"można usunąć; zamiast tego zarchiwizuj go."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-004] Tracking events must be created through log_track_event() on "
"the source record, not by direct ORM write."
msgstr ""
"[EHL-TRK-004] Zdarzenia śledzenia muszą być tworzone przez log_track_event()"
" na rekordzie źródłowym, a nie przez bezpośredni zapis ORM."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-005] Tracking event field(s) %(fields)s are immutable after "
"creation. Add a new event instead."
msgstr ""
"[EHL-TRK-005] Pole/pola zdarzenia śledzenia %(fields)s są niezmienne po "
"utworzeniu. Zamiast tego dodaj nowe zdarzenie."

#. module: eh_log_track_trace
#. odoo-python
#: code:addons/eh_log_track_trace/models/eh_log_track_event.py:0
msgid ""
"[EHL-TRK-006] Tracking events are append-only and cannot be deleted; archive"
" the source record instead."
msgstr ""
"[EHL-TRK-006] Zdarzenia śledzenia można tylko dołączać i nie można ich "
"usuwać; zamiast tego zarchiwizuj rekord źródłowy."

