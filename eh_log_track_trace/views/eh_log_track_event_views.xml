<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_track_event_list" model="ir.ui.view">
        <field name="name">eh.log.track.event.list</field>
        <field name="model">eh.log.track.event</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="occurred_at"/>
                <field name="event_code_id"/>
                <field name="category"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="description"/>
                <field name="location"/>
                <field name="source"/>
                <field name="is_milestone" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_track_event_form" model="ir.ui.view">
        <field name="name">eh.log.track.event.form</field>
        <field name="model">eh.log.track.event</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_code_id"/>
                            <field name="occurred_at"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                        <field name="location"/>
                    </group>
                    <group string="Operator Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Raw Payload" groups="eh_log_base.group_eh_log_auditor">
                        <field name="raw_payload" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_log_track_event_search" model="ir.ui.view">
        <field name="name">eh.log.track.event.search</field>
        <field name="model">eh.log.track.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="event_code_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <filter name="filter_milestone" string="Milestones" domain="[('is_milestone', '=', True)]"/>
                <filter name="filter_exception" string="Exceptions" domain="[('category', '=', 'exception')]"/>
                <filter name="filter_webhook" string="Webhook Source" domain="[('source', '=', 'webhook')]"/>
                <group>
                    <filter name="group_by_code" string="Event Code" context="{'group_by': 'event_code_id'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_by_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_by_model" string="Source Model" context="{'group_by': 'res_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_log_track_event" model="ir.actions.act_window">
        <field name="name">Tracking Events</field>
        <field name="res_model">eh.log.track.event</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
        <field name="context">{'search_default_filter_milestone': 1}</field>
    </record>

</odoo>
