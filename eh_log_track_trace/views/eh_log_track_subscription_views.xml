<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_track_subscription_list" model="ir.ui.view">
        <field name="name">eh.log.track.subscription.list</field>
        <field name="model">eh.log.track.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="channel"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_track_subscription_form" model="ir.ui.view">
        <field name="name">eh.log.track.subscription.form</field>
        <field name="model">eh.log.track.subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                        <group>
                            <field name="channel"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Event Codes">
                        <field name="event_code_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_track_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">eh.log.track.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
