<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_track_event_code_list" model="ir.ui.view">
        <field name="name">eh.log.track.event.code.list</field>
        <field name="model">eh.log.track.event.code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="is_milestone"/>
                <field name="icon_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_track_event_code_form" model="ir.ui.view">
        <field name="name">eh.log.track.event.code.form</field>
        <field name="model">eh.log.track.event.code</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="is_milestone"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="icon_name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Default Description">
                        <field name="default_description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_track_event_code" model="ir.actions.act_window">
        <field name="name">Event Codes</field>
        <field name="res_model">eh.log.track.event.code</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
