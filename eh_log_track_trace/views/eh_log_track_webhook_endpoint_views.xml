<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_track_webhook_endpoint_list" model="ir.ui.view">
        <field name="name">eh.log.track.webhook.endpoint.list</field>
        <field name="model">eh.log.track.webhook.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="carrier_name"/>
                <field name="name"/>
                <field name="target_model"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_track_webhook_endpoint_form" model="ir.ui.view">
        <field name="name">eh.log.track.webhook.endpoint.form</field>
        <field name="model">eh.log.track.webhook.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="carrier_name"/>
                            <field name="target_model"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="secret_key"/>
                            <field name="signature_header"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="JSON Field Paths">
                        <group>
                            <field name="reference_path"/>
                            <field name="event_code_path"/>
                        </group>
                        <group>
                            <field name="occurred_at_path"/>
                            <field name="location_path"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Code Mapping" name="mapping">
                            <field name="mapping_ids">
                                <list editable="bottom">
                                    <field name="carrier_code"/>
                                    <field name="event_code_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_track_webhook_endpoint" model="ir.actions.act_window">
        <field name="name">Carrier Webhooks</field>
        <field name="res_model">eh.log.track.webhook.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
