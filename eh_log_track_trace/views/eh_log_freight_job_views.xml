<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_freight_job_form_track" model="ir.ui.view">
        <field name="name">eh.log.freight.job.form.track</field>
        <field name="model">eh.log.freight.job</field>
        <field name="inherit_id" ref="eh_log_freight.view_eh_log_freight_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_track_events"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list-alt">
                    <field string="Tracking Events" name="track_event_count" widget="statinfo"/>
                </button>
                <button name="action_open_track_url"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-link">
                    <span class="o_stat_text">Public Page</span>
                </button>
            </xpath>
            <xpath expr="//field[@name='customer_reference']" position="after">
                <field name="tracking_reference"/>
            </xpath>
        </field>
    </record>

</odoo>
