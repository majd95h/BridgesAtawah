<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <data>

        <record id="seq_eh_log_carrier_rate_request" model="ir.sequence">
            <field name="name">Carrier Rate Request</field>
            <field name="code">eh.log.carrier.rate.request</field>
            <field name="prefix">RFQ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_carrier_booking" model="ir.sequence">
            <field name="name">Carrier Booking</field>
            <field name="code">eh.log.carrier.booking</field>
            <field name="prefix">BKG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
