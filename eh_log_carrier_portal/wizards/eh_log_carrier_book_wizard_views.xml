<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_carrier_book_wizard_form" model="ir.ui.view">
        <field name="name">eh.log.carrier.book.wizard.form</field>
        <field name="model">eh.log.carrier.book.wizard</field>
        <field name="arch" type="xml">
            <form string="Book Carrier">
                <group>
                    <field name="quote_id" readonly="1"/>
                    <field name="freight_job_id" options="{'no_create': True}"/>
                </group>
                <group string="Internal Note">
                    <field name="note" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_book"
                            type="object"
                            string="Book"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
