<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_carrier_booking_kanban" model="ir.ui.view">
        <field name="name">eh.log.carrier.booking.kanban</field>
        <field name="model">eh.log.carrier.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="carrier_profile_id"/>
                <field name="freight_job_id"/>
                <field name="state"/>
                <field name="carrier_booking_reference"/>
                <field name="confirmed_at"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div class="text-muted small"><field name="carrier_profile_id"/></div>
                            <div t-if="record.freight_job_id.raw_value">
                                <i class="fa fa-cube me-1" title="Freight Job"/><field name="freight_job_id"/>
                            </div>
                            <div t-if="record.carrier_booking_reference.raw_value" class="text-muted small mt-1">
                                Ref: <field name="carrier_booking_reference"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eh_log_carrier_booking_pivot" model="ir.ui.view">
        <field name="name">eh.log.carrier.booking.pivot</field>
        <field name="model">eh.log.carrier.booking</field>
        <field name="arch" type="xml">
            <pivot string="Booking Volume by Carrier" sample="1">
                <field name="carrier_profile_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_eh_log_carrier_booking_graph" model="ir.ui.view">
        <field name="name">eh.log.carrier.booking.graph</field>
        <field name="model">eh.log.carrier.booking</field>
        <field name="arch" type="xml">
            <graph string="Bookings by Carrier" sample="1" type="bar">
                <field name="carrier_profile_id"/>
            </graph>
        </field>
    </record>

</odoo>
