<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_carrier_lane_list" model="ir.ui.view">
        <field name="name">eh.log.carrier.lane.list</field>
        <field name="model">eh.log.carrier.lane</field>
        <field name="arch" type="xml">
            <list>
                <field name="carrier_profile_id"/>
                <field name="mode"/>
                <field name="origin_country_id"/>
                <field name="origin_location_code"/>
                <field name="destination_country_id"/>
                <field name="destination_location_code"/>
                <field name="transit_days_min"/>
                <field name="transit_days_max"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_eh_log_carrier_lane" model="ir.actions.act_window">
        <field name="name">Lanes</field>
        <field name="res_model">eh.log.carrier.lane</field>
        <field name="view_mode">list</field>
        <field name="views" eval="[(False, 'list')]"/>
    </record>

</odoo>
