msgstr ""
"[EHL-CTNR-LEASE-001] La date de fin du contrat %(name)s est antérieure à la "
"date de début."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_lease_contract.py:0
msgid ""
"[EHL-CTNR-LEASE-002] State changes on a lease contract must go through the "
"action buttons. Direct writes are rejected."
msgstr ""
"[EHL-CTNR-LEASE-002] Les changements d'état sur un contrat de location "
"doivent passer par les boutons d'action. Les écritures directes sont "
"rejetées."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_movement.py:0
msgid ""
"[EHL-CTNR-MOV-001] Container movements are append-only. The following fields"
" cannot be edited after capture: %(fields)s. Cancel the movement and create "
"a corrected one if a fix is required."
msgstr ""
"[EHL-CTNR-MOV-001] Les mouvements de conteneur sont en ajout seul. Les "
"champs suivants ne peuvent pas être modifiés après leur saisie : %(fields)s."
" Annulez le mouvement et créez-en un corrigé si une correction est "
"nécessaire."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_work_order.py:0
msgid ""
"[EHL-CTNR-WO-001] State changes on a work order must go through the action "
"buttons. Direct writes are rejected."
msgstr ""
"[EHL-CTNR-WO-001] Les changements d'état d'un ordre de travail doivent "
"passer par les boutons d'action. Les écritures directes sont rejetées."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_work_order.py:0
msgid ""
"[EHL-CTNR-WO-002] Work order %(name)s cannot move to Estimated without at "
"least one cost line."
msgstr ""
"[EHL-CTNR-WO-002] L'ordre de travail %(name)s ne peut pas passer à Estimé "
"sans au moins une ligne de coût."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_work_order.py:0
