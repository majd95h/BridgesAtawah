msgid "[EHL-CTNR-LEASE-001] Contract %(name)s end date is before start date."
msgstr ""
"[EHL-CTNR-LEASE-001] La data di fine del contratto %(name)s è precedente "
"alla data di inizio."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_lease_contract.py:0
msgid ""
"[EHL-CTNR-LEASE-002] State changes on a lease contract must go through the "
"action buttons. Direct writes are rejected."
msgstr ""
"[EHL-CTNR-LEASE-002] Le modifiche di stato su un contratto di locazione "
"devono avvenire tramite i pulsanti azione. Le scritture dirette vengono "
"rifiutate."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_movement.py:0
msgid ""
"[EHL-CTNR-MOV-001] Container movements are append-only. The following fields"
" cannot be edited after capture: %(fields)s. Cancel the movement and create "
"a corrected one if a fix is required."
msgstr ""
"[EHL-CTNR-MOV-001] I movimenti dei container sono solo in aggiunta. I "
"seguenti campi non possono essere modificati dopo l'acquisizione: "
"%(fields)s. Annulla il movimento e creane uno corretto se è necessaria una "
"correzione."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_work_order.py:0
msgid ""
"[EHL-CTNR-WO-001] State changes on a work order must go through the action "
"buttons. Direct writes are rejected."
msgstr ""
"[EHL-CTNR-WO-001] Le modifiche di stato su un ordine di lavoro devono "
"avvenire tramite i pulsanti di azione. Le scritture dirette vengono "
"rifiutate."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_work_order.py:0
msgid ""
"[EHL-CTNR-WO-002] Work order %(name)s cannot move to Estimated without at "
"least one cost line."
msgstr ""
"[EHL-CTNR-WO-002] L'ordine di lavoro %(name)s non può passare a Stimato "
"senza almeno una riga di costo."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_work_order.py:0
msgid "[EHL-CTNR-WO-003] Only logistics managers can approve M&R work orders."
msgstr ""
"[EHL-CTNR-WO-003] Solo i responsabili della logistica possono approvare gli "
"ordini di lavoro M&R."

#. module: eh_log_container_mgmt
#. odoo-python
#: code:addons/eh_log_container_mgmt/models/eh_log_container_mgmt_work_order.py:0
