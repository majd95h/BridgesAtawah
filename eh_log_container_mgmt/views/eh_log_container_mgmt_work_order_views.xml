<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_container_mgmt_work_order_list" model="ir.ui.view">
            <field name="name">eh.log.container.mgmt.work.order.list</field>
            <field name="model">eh.log.container.mgmt.work.order</field>
            <field name="arch" type="xml">
                <list string="M&amp;R Work Orders" decoration-info="state in ('draft', 'estimated')" decoration-warning="state == 'in_progress'" decoration-success="state in ('completed', 'closed')" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="container_id"/>
                    <field name="depot_id"/>
                    <field name="estimated_cost"/>
                    <field name="actual_cost"/>
                    <field name="approved_by_id" optional="show"/>
                    <field name="completed_at" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_container_mgmt_work_order_form" model="ir.ui.view">
            <field name="name">eh.log.container.mgmt.work.order.form</field>
            <field name="model">eh.log.container.mgmt.work.order</field>
            <field name="arch" type="xml">
                <form string="M&amp;R Work Order">
                    <header>
                        <button name="action_set_estimated" string="Submit Estimate" type="object" class="btn-primary" invisible="state != 'draft'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'estimated'" groups="eh_log_base.group_eh_log_manager"/>
                        <button name="action_back_to_draft" string="Back to Draft" type="object" class="btn-secondary" invisible="state != 'estimated'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_start" string="Start Repair" type="object" class="btn-primary" invisible="state != 'approved'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_complete" string="Mark Completed" type="object" class="btn-primary" invisible="state != 'in_progress'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_close" string="Close" type="object" class="btn-primary" invisible="state != 'completed'" groups="eh_log_base.group_eh_log_manager"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('completed', 'closed', 'cancelled')" groups="eh_log_base.group_eh_log_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,estimated,approved,in_progress,completed,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Subject">
                                <field name="container_id" options="{'no_create': True}"/>
                                <field name="depot_id" options="{'no_create': True}"/>
                                <field name="trigger_movement_id" options="{'no_create': True}"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Costs">
                                <field name="currency_id" options="{'no_create': True}"/>
                                <field name="estimated_cost" readonly="1"/>
                                <field name="actual_cost" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="fault_description" colspan="2"/>
                            <field name="repair_summary" colspan="2"/>
                        </group>
                        <notebook>
                            <page string="Cost Lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="repair_kind"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="estimated_unit_cost"/>
                                        <field name="estimated_amount"/>
                                        <field name="actual_unit_cost"/>
                                        <field name="actual_amount"/>
                                        <field name="currency_id" optional="hide" groups="base.group_multi_currency"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Audit">
                                <group>
                                    <group>
                                        <field name="estimated_at" readonly="1"/>
                                        <field name="approved_by_id" readonly="1"/>
                                        <field name="approved_at" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="started_at" readonly="1"/>
                                        <field name="completed_at" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_eh_log_container_mgmt_work_order" model="ir.actions.act_window">
            <field name="name">M&amp;R Work Orders</field>
            <field name="res_model">eh.log.container.mgmt.work.order</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
