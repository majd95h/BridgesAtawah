<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <!--
            Daily D&D alerter cron. Idempotent: scans containers in
            the gate-out-but-not-returned window and logs ones that
            crossed the free time threshold. Production deployments
            extend this to raise mail activities to the account owner.
        -->

        <record id="ir_cron_eh_log_container_mgmt_dnd_alert" model="ir.cron">
            <field name="name">EH Logistics: container D&amp;D free time alerts</field>
            <field name="model_id" ref="model_eh_log_freight_container"/>
            <field name="state">code</field>
            <field name="code">model._gc_dnd_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
