<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_edi_message_type_list" model="ir.ui.view">
        <field name="name">eh.log.edi.message.type.list</field>
        <field name="model">eh.log.edi.message.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="direction"/>
                <field name="encoding"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_edi_message_type_form" model="ir.ui.view">
        <field name="name">eh.log.edi.message.type.form</field>
        <field name="model">eh.log.edi.message.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="direction"/>
                            <field name="encoding"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_edi_message_type" model="ir.actions.act_window">
        <field name="name">Message Types</field>
        <field name="res_model">eh.log.edi.message.type</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
