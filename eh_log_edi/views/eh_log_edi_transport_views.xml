<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_edi_transport_list" model="ir.ui.view">
        <field name="name">eh.log.edi.transport.list</field>
        <field name="model">eh.log.edi.transport</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="protocol"/>
                <field name="host"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_edi_transport_form" model="ir.ui.view">
        <field name="name">eh.log.edi.transport.form</field>
        <field name="model">eh.log.edi.transport</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="protocol"/>
                            <field name="signing_required"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Endpoint">
                        <group>
                            <field name="host"/>
                            <field name="port"/>
                            <field name="username"/>
                            <field name="credentials_key"/>
                        </group>
                        <group>
                            <field name="target_directory"/>
                            <field name="target_email"/>
                            <field name="target_url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_edi_transport" model="ir.actions.act_window">
        <field name="name">Transports</field>
        <field name="res_model">eh.log.edi.transport</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
