<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form_edi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.eh_log_edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ERP Heritage EDI Hub"
                     string="ERP Heritage EDI Hub"
                     name="eh_log_edi">
                    <block title="Identity" name="edi_identity_block">
                        <setting id="edi_self_identifier"
                                 string="Self Identifier"
                                 help="Identifier inserted as the sender party on every outbound EDI envelope.">
                            <field name="eh_log_edi_self_identifier"
                                   placeholder="GLN, DUNS, or internal code"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
