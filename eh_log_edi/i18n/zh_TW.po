"%(protocol)s."
msgstr "[EHL-EDI-002] 傳輸 %(name)s 的通訊協定 %(protocol)s 需要主機或目標 URL。"

#. module: eh_log_edi
#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_transport.py:0
