#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_message_type.py:0
msgid ""
"[EHL-EDI-001] No translator registered for message type %(code)s direction "
"%(direction)s. Install the module that provides the translator or untick "
"Active."
msgstr ""
"[EHL-EDI-001] 未为消息类型 %(code)s 方向 %(direction)s 注册转换器。请安装提供该转换器的模块，或取消勾选“有效”。"

#. module: eh_log_edi
#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_transport.py:0
msgid ""
"[EHL-EDI-002] Transport %(name)s requires host or target URL for protocol "
"%(protocol)s."
msgstr "[EHL-EDI-002] 传输 %(name)s 的协议 %(protocol)s 需要主机或目标 URL。"

#. module: eh_log_edi
#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_transport.py:0
msgid "[EHL-EDI-003] Transport %(name)s requires a target email for SMTP."
msgstr "[EHL-EDI-003] 传输 %(name)s 需要用于 SMTP 的目标电子邮件。"

#. module: eh_log_edi
#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_transport.py:0
msgid ""
"[EHL-EDI-004] AS2 transport requires the optional pyas2 library; install it "
"and provide a signing certificate before activating an AS2 transport."
msgstr "[EHL-EDI-004] AS2 传输需要可选的 pyas2 库；请先安装该库并提供签名证书，然后再启用 AS2 传输。"

#. module: eh_log_edi
#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_transport.py:0
msgid "[EHL-EDI-005] Unsupported transport protocol %(protocol)s."
msgstr "[EHL-EDI-005] 不支持的传输协议 %(protocol)s。"

#. module: eh_log_edi
#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_transport.py:0
msgid ""
"[EHL-EDI-006] SFTP transport requires the optional paramiko library; pip "
"install paramiko on the Odoo host before activating SFTP."
msgstr ""
"[EHL-EDI-006] SFTP 传输需要可选的 paramiko 库；请在启用 SFTP 之前在 Odoo 主机上执行 pip install "
"paramiko。"

#. module: eh_log_edi
#. odoo-python
#: code:addons/eh_log_edi/models/eh_log_edi_transport.py:0
msgid ""
"[EHL-EDI-007] HTTP transport %(name)s rejected the payload with status "
"%(status)s: %(body)s"
msgstr "[EHL-EDI-007] HTTP 传输 %(name)s 拒绝了负载，状态 %(status)s：%(body)s"

