<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <data>

        <record id="seq_eh_log_edi_outbound" model="ir.sequence">
            <field name="name">EDI Outbound</field>
            <field name="code">eh.log.edi.outbound</field>
            <field name="prefix">EDO/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_edi_inbound" model="ir.sequence">
            <field name="name">EDI Inbound</field>
            <field name="code">eh.log.edi.inbound</field>
            <field name="prefix">EDI/%(year)s/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_edi_unb_control" model="ir.sequence">
            <field name="name">EDI UNB Interchange Control</field>
            <field name="code">eh.log.edi.unb.control</field>
            <field name="padding">6</field>
            <field name="number_next_actual">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_edi_unh_message" model="ir.sequence">
            <field name="name">EDI UNH Message Reference</field>
            <field name="code">eh.log.edi.unh.message</field>
            <field name="padding">6</field>
            <field name="number_next_actual">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
