            <field name="is_bonded" eval="True"/>
            <field name="website">https://opaz.gov.om</field>
        </record>

        <record id="fz_mazunah" model="eh.log.l10n.om.free.zone">
            <field name="code">MZN</field>
            <field name="name">Al Mazunah Free Zone</field>
            <field name="regulator_name">OPAZ (Public Authority for Special Economic Zones and Free Zones)</field>
            <field name="is_bonded" eval="True"/>
