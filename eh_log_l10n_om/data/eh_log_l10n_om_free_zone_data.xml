            <field name="name">Sohar Free Zone</field>
            <field name="regulator_name">SOHAR Port and Freezone</field>
            <field name="is_bonded" eval="True"/>
            <field name="website">https://soharportandfreezone.com</field>
        </record>

        <record id="fz_salalah" model="eh.log.l10n.om.free.zone">
            <field name="code">SLFZ</field>
            <field name="name">Salalah Free Zone</field>
