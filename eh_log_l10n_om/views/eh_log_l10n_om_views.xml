<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Free zones -->
        <record id="view_eh_log_l10n_om_free_zone_list" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.free.zone.list</field>
            <field name="model">eh.log.l10n.om.free.zone</field>
            <field name="arch" type="xml">
                <list string="Oman Free Zones">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="regulator_name" optional="show"/>
                    <field name="is_bonded" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_l10n_om_free_zone_form" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.free.zone.form</field>
            <field name="model">eh.log.l10n.om.free.zone</field>
            <field name="arch" type="xml">
                <form string="Oman Free Zone">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h1><field name="code"/></h1>
                            <field name="name"/>
                        </div>
                        <group>
                            <field name="regulator_name"/>
                            <field name="is_bonded"/>
                            <field name="website" widget="url"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group><field name="notes" colspan="2"/></group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eh_log_l10n_om_free_zone" model="ir.actions.act_window">
            <field name="name">Oman Free Zones</field>
            <field name="res_model">eh.log.l10n.om.free.zone</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Ports -->
        <record id="view_eh_log_l10n_om_port_list" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.port.list</field>
            <field name="model">eh.log.l10n.om.port</field>
            <field name="arch" type="xml">
                <list string="Oman Sea Ports">
                    <field name="unlocode"/>
                    <field name="name"/>
                    <field name="operator_name" optional="show"/>
                    <field name="container_terminal" optional="show"/>
                    <field name="bulk_terminal" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_l10n_om_port_form" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.port.form</field>
            <field name="model">eh.log.l10n.om.port</field>
            <field name="arch" type="xml">
                <form string="Oman Port">
                    <sheet>
                        <div class="oe_title">
                            <label for="unlocode"/>
                            <h1><field name="unlocode"/></h1>
                            <field name="name"/>
                        </div>
                        <group>
                            <group>
                                <field name="operator_name"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="container_terminal" widget="boolean_toggle"/>
                                <field name="bulk_terminal" widget="boolean_toggle"/>
                                <field name="petrochemical" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group><field name="notes" colspan="2"/></group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eh_log_l10n_om_port" model="ir.actions.act_window">
            <field name="name">Oman Ports</field>
            <field name="res_model">eh.log.l10n.om.port</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Airports -->
        <record id="view_eh_log_l10n_om_airport_list" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.airport.list</field>
            <field name="model">eh.log.l10n.om.airport</field>
            <field name="arch" type="xml">
                <list string="Oman Airports">
                    <field name="iata_code"/>
                    <field name="name"/>
                    <field name="cargo_capable" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_l10n_om_airport_form" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.airport.form</field>
            <field name="model">eh.log.l10n.om.airport</field>
            <field name="arch" type="xml">
                <form string="Oman Airport">
                    <sheet>
                        <div class="oe_title">
                            <label for="iata_code"/>
                            <h1><field name="iata_code"/></h1>
                            <field name="name"/>
                        </div>
                        <group>
                            <field name="icao_code"/>
                            <field name="cargo_capable"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group><field name="notes" colspan="2"/></group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eh_log_l10n_om_airport" model="ir.actions.act_window">
            <field name="name">Oman Airports</field>
            <field name="res_model">eh.log.l10n.om.airport</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Customs offices -->
        <record id="view_eh_log_l10n_om_customs_office_list" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.customs.office.list</field>
            <field name="model">eh.log.l10n.om.customs.office</field>
            <field name="arch" type="xml">
                <list string="Oman Customs Offices">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="office_kind"/>
                    <field name="parent_authority_id" optional="show"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_l10n_om_customs_office_form" model="ir.ui.view">
            <field name="name">eh.log.l10n.om.customs.office.form</field>
            <field name="model">eh.log.l10n.om.customs.office</field>
            <field name="arch" type="xml">
                <form string="Oman Customs Office">
                    <sheet>
                        <div class="oe_title">
                            <label for="code"/>
                            <h1><field name="code"/></h1>
                            <field name="name"/>
                        </div>
                        <group>
                            <field name="office_kind"/>
                            <field name="parent_authority_id" options="{'no_create': True}"/>
                            <field name="single_window_url" widget="url"/>
                            <field name="helpline_phone"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group><field name="notes" colspan="2"/></group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_eh_log_l10n_om_customs_office" model="ir.actions.act_window">
            <field name="name">Oman Customs Offices</field>
            <field name="res_model">eh.log.l10n.om.customs.office</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
