<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_report_eh_log_ship_nor" model="ir.actions.report">
        <field name="name">Notice of Readiness</field>
        <field name="model">eh.log.ship.port.call</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eh_log_ship_agency.report_ship_nor_document</field>
        <field name="report_file">eh_log_ship_agency.report_ship_nor_document</field>
        <field name="binding_model_id" ref="model_eh_log_ship_port_call"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="eh_log_base.paperformat_eh_log_portrait"/>
    </record>

    <template id="report_ship_nor_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="call">
                <t t-call="eh_log_base.eh_log_clean_layout">
                    <t t-set="company" t-value="call.company_id"/>
                    <t t-set="report_type" t-value="'pdf'"/>
                    <t t-call="eh_log_base.eh_log_report_styles"/>
                    <div class="page eh_pdf_page">
                        <t t-call="eh_log_base.eh_log_report_header">
                            <t t-set="title" t-value="'Notice of Readiness'"/>
                            <t t-set="company" t-value="call.company_id"/>
                        </t>

                        <div class="eh_pdf_meta">
                            <span><strong>Reference:</strong> <t t-out="call.name"/></span>
                            <span><strong>Vessel:</strong> <t t-out="call.vessel_id.name"/></span>
                            <span><strong>IMO:</strong> <t t-out="call.vessel_id.imo_number"/></span>
                            <span><strong>Port:</strong> <t t-out="call.port_partner_id.display_name"/></span>
                            <span><strong>Voyage:</strong> <t t-out="call.voyage_reference or ''"/></span>
                        </div>

                        <h2 class="eh_pdf_subtitle">Statement</h2>
                        <p>
                            On behalf of the Master and Owners of the
                            vessel <strong><t t-out="call.vessel_id.name"/></strong>
                            (IMO <t t-out="call.vessel_id.imo_number"/>),
                            we hereby tender Notice of Readiness that the
                            vessel arrived at <strong><t t-out="call.port_partner_id.display_name"/></strong>
                            on <strong><t t-out="call.arrived_at and call.arrived_at.strftime('%Y-%m-%d %H:%M') or '__________'"/></strong>
                            and is in all respects ready to load and / or
                            discharge cargo as per the relevant charter
                            party.
                        </p>

                        <h2 class="eh_pdf_subtitle">Acknowledgement</h2>
                        <table class="eh_pdf_table">
                            <thead>
                                <tr>
                                    <th>Role</th>
                                    <th>Name</th>
                                    <th>Signature</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Master</td><td>__________________</td><td>__________________</td><td>__________</td></tr>
                                <tr><td>Agent</td><td>__________________</td><td>__________________</td><td>__________</td></tr>
                                <tr><td>Receiver / Charterer</td><td>__________________</td><td>__________________</td><td>__________</td></tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
