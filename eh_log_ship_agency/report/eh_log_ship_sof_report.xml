<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_report_eh_log_ship_sof" model="ir.actions.report">
        <field name="name">Statement of Facts</field>
        <field name="model">eh.log.ship.port.call</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eh_log_ship_agency.report_ship_sof_document</field>
        <field name="report_file">eh_log_ship_agency.report_ship_sof_document</field>
        <field name="binding_model_id" ref="model_eh_log_ship_port_call"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="eh_log_base.paperformat_eh_log_portrait"/>
    </record>

    <template id="report_ship_sof_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="call">
                <t t-call="eh_log_base.eh_log_clean_layout">
                    <t t-set="company" t-value="call.company_id"/>
                    <t t-set="report_type" t-value="'pdf'"/>
                    <t t-call="eh_log_base.eh_log_report_styles"/>
                    <div class="page eh_pdf_page">
                        <t t-call="eh_log_base.eh_log_report_header">
                            <t t-set="title" t-value="'Statement of Facts'"/>
                            <t t-set="company" t-value="call.company_id"/>
                        </t>

                        <div class="eh_pdf_meta">
                            <span><strong>Vessel:</strong> <t t-out="call.vessel_id.name"/></span>
                            <span><strong>IMO:</strong> <t t-out="call.vessel_id.imo_number"/></span>
                            <span><strong>Voyage:</strong> <t t-out="call.voyage_reference or ''"/></span>
                            <span><strong>Port:</strong> <t t-out="call.port_partner_id.display_name"/></span>
                            <span><strong>Berth:</strong> <t t-out="call.berth_id.name or ''"/></span>
                            <span><strong>Reference:</strong> <t t-out="call.name"/></span>
                        </div>

                        <h2 class="eh_pdf_subtitle">Events</h2>
                        <table class="eh_pdf_table">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>Laytime</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="call.sof_event_ids.sorted(lambda e: e.occurred_at)" t-as="event">
                                    <td><t t-out="event.occurred_at and event.occurred_at.strftime('%Y-%m-%d %H:%M') or ''"/></td>
                                    <td><t t-out="event.description"/></td>
                                    <td><t t-out="event.event_category or ''"/></td>
                                    <td><t t-out="event.counts_against_laytime and 'Yes' or 'No'"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
