<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_ship_sof_event_list" model="ir.ui.view">
        <field name="name">eh.log.ship.sof.event.list</field>
        <field name="model">eh.log.ship.sof.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="occurred_at"/>
                <field name="port_call_id"/>
                <field name="description"/>
                <field name="event_category"/>
                <field name="counts_against_laytime"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_ship_sof_event_form" model="ir.ui.view">
        <field name="name">eh.log.ship.sof.event.form</field>
        <field name="model">eh.log.ship.sof.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="port_call_id"/>
                            <field name="occurred_at"/>
                            <field name="event_category"/>
                            <field name="counts_against_laytime"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_ship_sof_event" model="ir.actions.act_window">
        <field name="name">SOF Events</field>
        <field name="res_model">eh.log.ship.sof.event</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
