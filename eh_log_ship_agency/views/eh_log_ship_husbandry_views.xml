<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_ship_husbandry_service_list" model="ir.ui.view">
        <field name="name">eh.log.ship.husbandry.service.list</field>
        <field name="model">eh.log.ship.husbandry.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="charge_code_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_ship_husbandry_service_form" model="ir.ui.view">
        <field name="name">eh.log.ship.husbandry.service.form</field>
        <field name="model">eh.log.ship.husbandry.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="charge_code_id"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_ship_husbandry_service" model="ir.actions.act_window">
        <field name="name">Husbandry Services</field>
        <field name="res_model">eh.log.ship.husbandry.service</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
