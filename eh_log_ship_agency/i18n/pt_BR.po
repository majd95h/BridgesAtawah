#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid ""
"[EHL-SHP-001] IMO number %(imo)s is invalid. Must be exactly seven digits "
"with a valid IMO checksum (Resolution A.1078(28))."
msgstr ""
"[EHL-SHP-001] O número IMO %(imo)s é inválido. Deve ter exatamente sete "
"dígitos com um checksum IMO válido (Resolução A.1078(28))."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid "[EHL-SHP-002] MMSI %(mmsi)s must be exactly nine digits."
msgstr "[EHL-SHP-002] O MMSI %(mmsi)s deve ter exatamente nove dígitos."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-003] Berth %(code)s depth must be positive."
msgstr "[EHL-SHP-003] A profundidade do berço %(code)s deve ser positiva."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-004] Berth %(code)s max LOA must be positive."
msgstr "[EHL-SHP-004] A LOA máxima do berço %(code)s deve ser positiva."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-005] Port call %(name)s has no berth assigned; provide one before "
"marking berthed."
msgstr ""
"[EHL-SHP-005] A escala portuária %(name)s não tem berço atribuído; atribua "
"um antes de marcar como atracado."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-006] Berth %(berth)s is not compatible with vessel %(vessel)s: "
"%(reasons)s"
msgstr ""
"[EHL-SHP-006] O berço %(berth)s não é compatível com a embarcação "
"%(vessel)s: %(reasons)s"

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-007] Cannot close port call %(name)s while the disbursement account"
" is in state %(state)s."
msgstr ""
"[EHL-SHP-007] Não é possível fechar a escala portuária %(name)s enquanto a "
"conta de desembolso estiver no estado %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-008] NOR can only be tendered between arrived and berthed states; "
"current state is %(state)s."
msgstr ""
"[EHL-SHP-008] O NOR só pode ser apresentado entre os estados chegado e "
"atracado; o estado atual é %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid "[EHL-SHP-009] Port-call state must change via the action buttons."
msgstr ""
"[EHL-SHP-009] O estado de uma escala portuária deve ser alterado pelos "
"botões de ação."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid ""
"[EHL-SHP-010] SOF event field(s) %(fields)s are immutable after creation. "
"Append a corrective event instead."
msgstr ""
"[EHL-SHP-010] O(s) campo(s) de evento SOF %(fields)s são imutáveis após a "
"criação. Em vez disso, anexe um evento corretivo."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid "[EHL-SHP-011] SOF events are append-only and cannot be deleted."
msgstr ""
"[EHL-SHP-011] Os eventos SOF são somente de anexação e não podem ser "
"excluídos."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-012] Disbursement account %(name)s has no estimate lines; add at "
"least one before issuing the proforma."
msgstr ""
"[EHL-SHP-012] A conta de desembolso %(name)s não tem linhas de estimativa; "
"adicione pelo menos uma antes de emitir a proforma."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid "[EHL-SHP-013] Disbursement account %(name)s has no lines."
msgstr "[EHL-SHP-013] A conta de desembolso %(name)s não tem linhas."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-014] Disbursement-account state must change via the action buttons."
msgstr ""
"[EHL-SHP-014] O estado de uma conta de desembolso deve ser alterado pelos "
"botões de ação."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-015] Disbursement account %(name)s is %(state)s; lines are read-"
"only."
msgstr ""
"[EHL-SHP-015] A conta de desembolso %(name)s está %(state)s; as linhas são "
"somente leitura."

