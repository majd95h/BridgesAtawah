#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid ""
"[EHL-SHP-001] IMO number %(imo)s is invalid. Must be exactly seven digits "
"with a valid IMO checksum (Resolution A.1078(28))."
msgstr ""
"[EHL-SHP-001] رقم IMO ‏%(imo)s غير صالح. يجب أن يتكون من سبعة أرقام بالضبط "
"مع مجموع تحقق IMO صالح (القرار A.1078(28))."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid "[EHL-SHP-002] MMSI %(mmsi)s must be exactly nine digits."
msgstr "[EHL-SHP-002] يجب أن يتكون MMSI ‏%(mmsi)s من تسعة أرقام بالضبط."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-003] Berth %(code)s depth must be positive."
msgstr "[EHL-SHP-003] يجب أن يكون عمق الرصيف %(code)s قيمة موجبة."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-004] Berth %(code)s max LOA must be positive."
msgstr ""
"[EHL-SHP-004] يجب أن يكون الحد الأقصى لطول السفينة الكلي (LOA) للرصيف "
"%(code)s قيمة موجبة."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-005] Port call %(name)s has no berth assigned; provide one before "
"marking berthed."
msgstr ""
"[EHL-SHP-005] زيارة الميناء %(name)s ليس لها رصيف معين؛ قم بتوفير واحد قبل "
"وضع علامة \"راسية\"."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-006] Berth %(berth)s is not compatible with vessel %(vessel)s: "
"%(reasons)s"
msgstr ""
"[EHL-SHP-006] الرصيف %(berth)s غير متوافق مع السفينة %(vessel)s: %(reasons)s"

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-007] Cannot close port call %(name)s while the disbursement account"
" is in state %(state)s."
msgstr ""
"[EHL-SHP-007] لا يمكن إغلاق زيارة الميناء %(name)s طالما أن حساب المصروفات "
"في حالة %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-008] NOR can only be tendered between arrived and berthed states; "
"current state is %(state)s."
msgstr ""
"[EHL-SHP-008] لا يمكن تقديم NOR إلا بين حالتي الوصول والرسو؛ الحالة الحالية "
"هي %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid "[EHL-SHP-009] Port-call state must change via the action buttons."
msgstr "[EHL-SHP-009] يجب تغيير حالة زيارة الميناء عبر أزرار الإجراءات."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid ""
"[EHL-SHP-010] SOF event field(s) %(fields)s are immutable after creation. "
"Append a corrective event instead."
msgstr ""
"[EHL-SHP-010] حقول حدث SOF ‏%(fields)s غير قابلة للتغيير بعد الإنشاء. أضف "
"حدثاً تصحيحياً بدلاً من ذلك."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid "[EHL-SHP-011] SOF events are append-only and cannot be deleted."
msgstr "[EHL-SHP-011] أحداث SOF قابلة للإضافة فقط ولا يمكن حذفها."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-012] Disbursement account %(name)s has no estimate lines; add at "
"least one before issuing the proforma."
msgstr ""
"[EHL-SHP-012] حساب المصروفات %(name)s ليس له بنود تقديرية؛ أضف واحداً على "
"الأقل قبل إصدار الفاتورة المبدئية."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid "[EHL-SHP-013] Disbursement account %(name)s has no lines."
msgstr "[EHL-SHP-013] حساب المصروفات %(name)s ليس له بنود."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-014] Disbursement-account state must change via the action buttons."
msgstr "[EHL-SHP-014] يجب تغيير حالة حساب المصروفات عبر أزرار الإجراءات."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-015] Disbursement account %(name)s is %(state)s; lines are read-"
"only."
msgstr ""
"[EHL-SHP-015] حساب المصروفات %(name)s في حالة %(state)s؛ البنود للقراءة فقط."

