#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid ""
"[EHL-SHP-001] IMO number %(imo)s is invalid. Must be exactly seven digits "
"with a valid IMO checksum (Resolution A.1078(28))."
msgstr ""
"[EHL-SHP-001] Số IMO %(imo)s không hợp lệ. Phải có đúng bảy chữ số với "
"checksum IMO hợp lệ (Nghị quyết A.1078(28))."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid "[EHL-SHP-002] MMSI %(mmsi)s must be exactly nine digits."
msgstr "[EHL-SHP-002] MMSI %(mmsi)s phải có đúng chín chữ số."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-003] Berth %(code)s depth must be positive."
msgstr "[EHL-SHP-003] Độ sâu của bến %(code)s phải là số dương."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-004] Berth %(code)s max LOA must be positive."
msgstr "[EHL-SHP-004] LOA tối đa của bến %(code)s phải là số dương."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-005] Port call %(name)s has no berth assigned; provide one before "
"marking berthed."
msgstr ""
"[EHL-SHP-005] Chuyến ghé cảng %(name)s chưa được phân bến; hãy chỉ định một "
"bến trước khi đánh dấu đã cập bến."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-006] Berth %(berth)s is not compatible with vessel %(vessel)s: "
"%(reasons)s"
msgstr ""
"[EHL-SHP-006] Bến %(berth)s không tương thích với tàu %(vessel)s: "
"%(reasons)s"

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-007] Cannot close port call %(name)s while the disbursement account"
" is in state %(state)s."
msgstr ""
"[EHL-SHP-007] Không thể đóng chuyến ghé cảng %(name)s khi tài khoản chi hộ "
"đang ở trạng thái %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-008] NOR can only be tendered between arrived and berthed states; "
"current state is %(state)s."
msgstr ""
"[EHL-SHP-008] NOR chỉ có thể được trao giữa các trạng thái đã đến và đã cập "
"bến; trạng thái hiện tại là %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid "[EHL-SHP-009] Port-call state must change via the action buttons."
msgstr ""
"[EHL-SHP-009] Trạng thái chuyến ghé cảng phải được thay đổi qua các nút thao"
" tác."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid ""
"[EHL-SHP-010] SOF event field(s) %(fields)s are immutable after creation. "
"Append a corrective event instead."
msgstr ""
"[EHL-SHP-010] (Các) trường sự kiện SOF %(fields)s không thể thay đổi sau khi"
" tạo. Thay vào đó, hãy thêm một sự kiện điều chỉnh."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid "[EHL-SHP-011] SOF events are append-only and cannot be deleted."
msgstr "[EHL-SHP-011] Sự kiện SOF chỉ được thêm vào và không thể xóa."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-012] Disbursement account %(name)s has no estimate lines; add at "
"least one before issuing the proforma."
msgstr ""
"[EHL-SHP-012] Tài khoản chi hộ %(name)s không có dòng ước tính; hãy thêm ít "
"nhất một dòng trước khi phát hành proforma."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
