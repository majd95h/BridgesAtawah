#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid ""
"[EHL-SHP-001] IMO number %(imo)s is invalid. Must be exactly seven digits "
"with a valid IMO checksum (Resolution A.1078(28))."
msgstr ""
"[EHL-SHP-001] Die IMO-Nummer %(imo)s ist ungültig. Sie muss genau sieben "
"Ziffern mit einer gültigen IMO-Prüfsumme aufweisen (Entschließung "
"A.1078(28))."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid "[EHL-SHP-002] MMSI %(mmsi)s must be exactly nine digits."
msgstr "[EHL-SHP-002] MMSI %(mmsi)s muss genau neun Ziffern haben."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-003] Berth %(code)s depth must be positive."
msgstr "[EHL-SHP-003] Die Tiefe des Liegeplatzes %(code)s muss positiv sein."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-004] Berth %(code)s max LOA must be positive."
msgstr ""
"[EHL-SHP-004] Die maximale LOA des Liegeplatzes %(code)s muss positiv sein."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-005] Port call %(name)s has no berth assigned; provide one before "
"marking berthed."
msgstr ""
"[EHL-SHP-005] Dem Hafenanlauf %(name)s ist kein Liegeplatz zugewiesen; geben"
" Sie einen an, bevor Sie als angelegt markieren."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-006] Berth %(berth)s is not compatible with vessel %(vessel)s: "
"%(reasons)s"
msgstr ""
"[EHL-SHP-006] Liegeplatz %(berth)s ist nicht mit Schiff %(vessel)s "
"kompatibel: %(reasons)s"

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-007] Cannot close port call %(name)s while the disbursement account"
" is in state %(state)s."
msgstr ""
"[EHL-SHP-007] Hafenanlauf %(name)s kann nicht geschlossen werden, solange "
"das Auslagenkonto im Status %(state)s ist."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-008] NOR can only be tendered between arrived and berthed states; "
"current state is %(state)s."
msgstr ""
"[EHL-SHP-008] Die NOR kann nur zwischen den Status angekommen und angelegt "
"übergeben werden; aktueller Status ist %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid "[EHL-SHP-009] Port-call state must change via the action buttons."
msgstr ""
"[EHL-SHP-009] Der Status eines Hafenanlaufs muss über die "
"Aktionsschaltflächen geändert werden."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid ""
"[EHL-SHP-010] SOF event field(s) %(fields)s are immutable after creation. "
"Append a corrective event instead."
msgstr ""
"[EHL-SHP-010] Das/die SOF-Ereignisfeld(er) %(fields)s ist/sind nach der "
"Erstellung unveränderlich. Fügen Sie stattdessen ein Korrekturereignis "
"hinzu."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid "[EHL-SHP-011] SOF events are append-only and cannot be deleted."
msgstr ""
"[EHL-SHP-011] SOF-Ereignisse können nur angehängt und nicht gelöscht werden."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-012] Disbursement account %(name)s has no estimate lines; add at "
"least one before issuing the proforma."
msgstr ""
"[EHL-SHP-012] Auslagenkonto %(name)s hat keine Schätzpositionen; fügen Sie "
"mindestens eine hinzu, bevor Sie die Proforma ausstellen."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid "[EHL-SHP-013] Disbursement account %(name)s has no lines."
msgstr "[EHL-SHP-013] Auslagenkonto %(name)s hat keine Positionen."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-014] Disbursement-account state must change via the action buttons."
msgstr ""
"[EHL-SHP-014] Der Status eines Auslagenkontos muss über die "
"Aktionsschaltflächen geändert werden."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-015] Disbursement account %(name)s is %(state)s; lines are read-"
"only."
msgstr ""
"[EHL-SHP-015] Auslagenkonto %(name)s ist %(state)s; Positionen sind "
"schreibgeschützt."

#. module: eh_log_ship_agency
