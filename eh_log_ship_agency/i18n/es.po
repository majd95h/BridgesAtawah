#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid ""
"[EHL-SHP-001] IMO number %(imo)s is invalid. Must be exactly seven digits "
"with a valid IMO checksum (Resolution A.1078(28))."
msgstr ""
"[EHL-SHP-001] El número IMO %(imo)s no es válido. Debe tener exactamente "
"siete dígitos con una suma de comprobación IMO válida (Resolución "
"A.1078(28))."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid "[EHL-SHP-002] MMSI %(mmsi)s must be exactly nine digits."
msgstr "[EHL-SHP-002] El MMSI %(mmsi)s debe tener exactamente nueve dígitos."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-003] Berth %(code)s depth must be positive."
msgstr ""
"[EHL-SHP-003] La profundidad del atracadero %(code)s debe ser positiva."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-004] Berth %(code)s max LOA must be positive."
msgstr ""
"[EHL-SHP-004] La LOA máxima del atracadero %(code)s debe ser positiva."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-005] Port call %(name)s has no berth assigned; provide one before "
"marking berthed."
msgstr ""
"[EHL-SHP-005] La escala portuaria %(name)s no tiene atracadero asignado; "
"asigne uno antes de marcar como atracado."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-006] Berth %(berth)s is not compatible with vessel %(vessel)s: "
"%(reasons)s"
msgstr ""
"[EHL-SHP-006] El atracadero %(berth)s no es compatible con el buque "
"%(vessel)s: %(reasons)s"

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-007] Cannot close port call %(name)s while the disbursement account"
" is in state %(state)s."
msgstr ""
"[EHL-SHP-007] No se puede cerrar la escala portuaria %(name)s mientras la "
"cuenta de desembolsos esté en estado %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-008] NOR can only be tendered between arrived and berthed states; "
"current state is %(state)s."
msgstr ""
"[EHL-SHP-008] El NOR solo puede presentarse entre los estados llegado y "
"atracado; el estado actual es %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid "[EHL-SHP-009] Port-call state must change via the action buttons."
msgstr ""
"[EHL-SHP-009] El estado de una escala portuaria debe cambiarse mediante los "
"botones de acción."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid ""
"[EHL-SHP-010] SOF event field(s) %(fields)s are immutable after creation. "
"Append a corrective event instead."
msgstr ""
"[EHL-SHP-010] Los campos de evento SOF %(fields)s son inmutables después de "
"la creación. En su lugar, agregue un evento correctivo."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid "[EHL-SHP-011] SOF events are append-only and cannot be deleted."
msgstr ""
"[EHL-SHP-011] Los eventos SOF son de solo anexado y no se pueden eliminar."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-012] Disbursement account %(name)s has no estimate lines; add at "
"least one before issuing the proforma."
msgstr ""
"[EHL-SHP-012] La cuenta de desembolsos %(name)s no tiene líneas de "
"estimación; agregue al menos una antes de emitir la proforma."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid "[EHL-SHP-013] Disbursement account %(name)s has no lines."
msgstr "[EHL-SHP-013] La cuenta de desembolsos %(name)s no tiene líneas."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-014] Disbursement-account state must change via the action buttons."
msgstr ""
"[EHL-SHP-014] El estado de una cuenta de desembolsos debe cambiarse mediante"
" los botones de acción."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-015] Disbursement account %(name)s is %(state)s; lines are read-"
"only."
msgstr ""
"[EHL-SHP-015] La cuenta de desembolsos %(name)s está %(state)s; las líneas "
"son de solo lectura."

