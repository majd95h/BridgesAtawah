#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid ""
"[EHL-SHP-001] IMO number %(imo)s is invalid. Must be exactly seven digits "
"with a valid IMO checksum (Resolution A.1078(28))."
msgstr ""
"[EHL-SHP-001] Il numero IMO %(imo)s non è valido. Deve essere composto "
"esattamente da sette cifre con un checksum IMO valido (Risoluzione "
"A.1078(28))."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_vessel.py:0
msgid "[EHL-SHP-002] MMSI %(mmsi)s must be exactly nine digits."
msgstr ""
"[EHL-SHP-002] MMSI %(mmsi)s deve essere composto esattamente da nove cifre."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-003] Berth %(code)s depth must be positive."
msgstr ""
"[EHL-SHP-003] La profondità dell'ormeggio %(code)s deve essere positiva."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_berth.py:0
msgid "[EHL-SHP-004] Berth %(code)s max LOA must be positive."
msgstr ""
"[EHL-SHP-004] La LOA massima dell'ormeggio %(code)s deve essere positiva."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-005] Port call %(name)s has no berth assigned; provide one before "
"marking berthed."
msgstr ""
"[EHL-SHP-005] La toccata %(name)s non ha un ormeggio assegnato; assegnane "
"uno prima di contrassegnare come ormeggiata."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-006] Berth %(berth)s is not compatible with vessel %(vessel)s: "
"%(reasons)s"
msgstr ""
"[EHL-SHP-006] L'ormeggio %(berth)s non è compatibile con la nave %(vessel)s:"
" %(reasons)s"

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-007] Cannot close port call %(name)s while the disbursement account"
" is in state %(state)s."
msgstr ""
"[EHL-SHP-007] Impossibile chiudere la toccata %(name)s mentre il conto "
"esborsi è nello stato %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid ""
"[EHL-SHP-008] NOR can only be tendered between arrived and berthed states; "
"current state is %(state)s."
msgstr ""
"[EHL-SHP-008] Il NOR può essere presentato solo tra gli stati arrivata e "
"ormeggiata; lo stato attuale è %(state)s."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_port_call.py:0
msgid "[EHL-SHP-009] Port-call state must change via the action buttons."
msgstr ""
"[EHL-SHP-009] Lo stato di una toccata deve essere modificato tramite i "
"pulsanti di azione."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid ""
"[EHL-SHP-010] SOF event field(s) %(fields)s are immutable after creation. "
"Append a corrective event instead."
msgstr ""
"[EHL-SHP-010] Il/i campo/i evento SOF %(fields)s sono immutabili dopo la "
"creazione. Aggiungi invece un evento correttivo."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_sof_event.py:0
msgid "[EHL-SHP-011] SOF events are append-only and cannot be deleted."
msgstr ""
"[EHL-SHP-011] Gli eventi SOF sono di sola aggiunta e non possono essere "
"eliminati."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-012] Disbursement account %(name)s has no estimate lines; add at "
"least one before issuing the proforma."
msgstr ""
"[EHL-SHP-012] Il conto esborsi %(name)s non ha righe di stima; aggiungine "
"almeno una prima di emettere la proforma."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid "[EHL-SHP-013] Disbursement account %(name)s has no lines."
msgstr "[EHL-SHP-013] Il conto esborsi %(name)s non ha righe."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-014] Disbursement-account state must change via the action buttons."
msgstr ""
"[EHL-SHP-014] Lo stato di un conto esborsi deve essere modificato tramite i "
"pulsanti di azione."

#. module: eh_log_ship_agency
#. odoo-python
#: code:addons/eh_log_ship_agency/models/eh_log_ship_disbursement.py:0
msgid ""
"[EHL-SHP-015] Disbursement account %(name)s is %(state)s; lines are read-"
"only."
msgstr ""
"[EHL-SHP-015] Il conto esborsi %(name)s è %(state)s; le righe sono in sola "
"lettura."

