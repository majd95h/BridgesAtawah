<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <data>

        <record id="seq_eh_log_ship_port_call" model="ir.sequence">
            <field name="name">Port Call</field>
            <field name="code">eh.log.ship.port.call</field>
            <field name="prefix">PCL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_ship_disbursement_account" model="ir.sequence">
            <field name="name">Disbursement Account</field>
            <field name="code">eh.log.ship.disbursement.account</field>
            <field name="prefix">DA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
