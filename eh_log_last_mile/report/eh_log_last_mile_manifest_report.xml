<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_report_eh_log_last_mile_manifest" model="ir.actions.report">
        <field name="name">Driver Manifest</field>
        <field name="model">eh.log.last.mile.wave</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eh_log_last_mile.report_wave_manifest_document</field>
        <field name="report_file">eh_log_last_mile.report_wave_manifest_document</field>
        <field name="binding_model_id" ref="model_eh_log_last_mile_wave"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="eh_log_base.paperformat_eh_log_portrait"/>
    </record>

    <template id="report_wave_manifest_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wave">
                <t t-call="eh_log_base.eh_log_clean_layout">
                    <t t-set="company" t-value="wave.company_id"/>
                    <t t-set="report_type" t-value="'pdf'"/>
                    <t t-call="eh_log_base.eh_log_report_styles"/>
                    <div class="page eh_pdf_page">
                        <t t-call="eh_log_base.eh_log_report_header">
                            <t t-set="title" t-value="'Driver Manifest'"/>
                            <t t-set="company" t-value="wave.company_id"/>
                        </t>

                        <div class="eh_pdf_meta">
                            <span><strong>Wave:</strong> <t t-out="wave.name"/></span>
                            <span><strong>Date:</strong> <t t-out="wave.scheduled_date and wave.scheduled_date.strftime('%Y-%m-%d') or ''"/></span>
                            <span><strong>Driver:</strong> <t t-out="wave.driver_id.name"/></span>
                            <span><strong>Vehicle:</strong> <t t-out="wave.vehicle_id.display_name"/></span>
                        </div>

                        <h2 class="eh_pdf_subtitle">Stops (<t t-out="wave.delivery_count"/>)</h2>
                        <table class="eh_pdf_table">
                            <thead>
                                <tr>
                                    <th class="text-end">#</th>
                                    <th>Reference</th>
                                    <th>Customer</th>
                                    <th>Address</th>
                                    <th>Window</th>
                                    <th class="text-end">Pkgs</th>
                                    <th class="text-end">COD</th>
                                    <th>Signature</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="wave.delivery_ids.sorted(lambda d: d.sequence)" t-as="del">
                                    <td class="text-end"><t t-out="del.sequence"/></td>
                                    <td><t t-out="del.name"/></td>
                                    <td><t t-out="del.customer_id.display_name"/></td>
                                    <td>
                                        <t t-out="del.delivery_partner_id.display_name or del.customer_id.display_name"/>
                                    </td>
                                    <td>
                                        <t t-out="del.scheduled_window_start and del.scheduled_window_start.strftime('%H:%M') or ''"/>
                                        -
                                        <t t-out="del.scheduled_window_end and del.scheduled_window_end.strftime('%H:%M') or ''"/>
                                    </td>
                                    <td class="text-end"><t t-out="del.package_count"/></td>
                                    <td class="text-end">
                                        <t t-if="del.cod_amount">
                                            <t t-out="'{:.2f}'.format(del.cod_amount)"/>
                                        </t>
                                    </td>
                                    <td>__________________</td>
                                </tr>
                            </tbody>
                        </table>

                        <h2 class="eh_pdf_subtitle">End-of-Shift Cash-Up</h2>
                        <table class="eh_pdf_table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>COD Expected</td>
                                    <td class="text-end"><t t-out="'{:,.2f}'.format(wave.cod_expected)"/></td>
                                </tr>
                                <tr>
                                    <td>COD Collected</td>
                                    <td class="text-end"><t t-out="'{:,.2f}'.format(wave.cod_collected)"/></td>
                                </tr>
                                <tr class="eh_pdf_grand_total">
                                    <td>COD Outstanding</td>
                                    <td class="text-end"><t t-out="'{:,.2f}'.format(wave.cod_outstanding)"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="eh_pdf_signature_block">
                            <p>Driver acknowledges receipt of the deliveries listed above and undertakes to remit any COD amounts collected at end-of-shift cash-up.</p>
                            <div class="eh_pdf_signature_line">Driver Signature</div>
                        </div>

                        <t t-call="eh_log_base.eh_log_report_footer"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
