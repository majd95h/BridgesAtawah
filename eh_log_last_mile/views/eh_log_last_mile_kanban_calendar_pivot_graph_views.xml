<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_last_mile_wave_kanban" model="ir.ui.view">
        <field name="name">eh.log.last.mile.wave.kanban</field>
        <field name="model">eh.log.last.mile.wave</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="scheduled_date"/>
                <field name="state"/>
                <field name="delivery_count"/>
                <field name="completion_pct"/>
                <field name="cod_outstanding"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <field name="scheduled_date" widget="date" class="float-end small text-muted"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-id-badge me-1" title="Driver"/><field name="driver_id"/></div>
                                <div><i class="fa fa-truck me-1" title="Vehicle"/><field name="vehicle_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left text-muted small">
                                    <field name="delivery_count"/> stops
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="completion_pct" widget="progressbar"/>
                                </div>
                            </div>
                            <div class="mt-1" t-if="record.cod_outstanding.raw_value">
                                <span class="badge text-bg-warning">COD outstanding: <field name="cod_outstanding"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eh_log_last_mile_wave_calendar" model="ir.ui.view">
        <field name="name">eh.log.last.mile.wave.calendar</field>
        <field name="model">eh.log.last.mile.wave</field>
        <field name="arch" type="xml">
            <calendar string="Waves"
                      date_start="scheduled_date"
                      color="state"
                      mode="month">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="delivery_count"/>
            </calendar>
        </field>
    </record>

    <record id="view_eh_log_last_mile_wave_pivot" model="ir.ui.view">
        <field name="name">eh.log.last.mile.wave.pivot</field>
        <field name="model">eh.log.last.mile.wave</field>
        <field name="arch" type="xml">
            <pivot string="Wave Performance" sample="1">
                <field name="driver_id" type="row"/>
                <field name="state" type="col"/>
                <field name="delivery_count" type="measure"/>
                <field name="cod_collected" type="measure"/>
                <field name="cod_expected" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_eh_log_last_mile_wave_graph" model="ir.ui.view">
        <field name="name">eh.log.last.mile.wave.graph</field>
        <field name="model">eh.log.last.mile.wave</field>
        <field name="arch" type="xml">
            <graph string="Waves by State" sample="1" type="bar">
                <field name="state"/>
                <field name="delivery_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_eh_log_last_mile_delivery_kanban" model="ir.ui.view">
        <field name="name">eh.log.last.mile.delivery.kanban</field>
        <field name="model">eh.log.last.mile.delivery</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="scheduled_window_start"/>
                <field name="scheduled_window_end"/>
                <field name="cod_amount"/>
                <field name="package_count"/>
                <field name="attempt_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <span t-if="record.attempt_count.raw_value > 1" class="badge text-bg-warning float-end">
                                    <field name="attempt_count"/> attempts
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><field name="customer_id"/></div>
                                <div class="text-muted small mt-1">
                                    <field name="scheduled_window_start" widget="datetime"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 small text-muted">
                                <div class="oe_kanban_bottom_left">
                                    <i class="fa fa-cube me-1" title="Packages"/><field name="package_count"/>
                                </div>
                                <div class="oe_kanban_bottom_right" t-if="record.cod_amount.raw_value">
                                    COD <field name="cod_amount" widget="float"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eh_log_last_mile_delivery_calendar" model="ir.ui.view">
        <field name="name">eh.log.last.mile.delivery.calendar</field>
        <field name="model">eh.log.last.mile.delivery</field>
        <field name="arch" type="xml">
            <calendar string="Deliveries"
                      date_start="scheduled_window_start"
                      date_stop="scheduled_window_end"
                      color="state"
                      mode="day">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="cod_amount"/>
            </calendar>
        </field>
    </record>

    <record id="view_eh_log_last_mile_delivery_pivot" model="ir.ui.view">
        <field name="name">eh.log.last.mile.delivery.pivot</field>
        <field name="model">eh.log.last.mile.delivery</field>
        <field name="arch" type="xml">
            <pivot string="Delivery Analysis" sample="1">
                <field name="customer_id" type="row"/>
                <field name="state" type="col"/>
                <field name="package_count" type="measure"/>
                <field name="cod_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_eh_log_last_mile_delivery_graph" model="ir.ui.view">
        <field name="name">eh.log.last.mile.delivery.graph</field>
        <field name="model">eh.log.last.mile.delivery</field>
        <field name="arch" type="xml">
            <graph string="Deliveries by State" sample="1" type="bar">
                <field name="state"/>
                <field name="package_count" type="measure"/>
            </graph>
        </field>
    </record>

</odoo>
