<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_log_last_mile_wave_list" model="ir.ui.view">
            <field name="name">eh.log.last.mile.wave.list</field>
            <field name="model">eh.log.last.mile.wave</field>
            <field name="arch" type="xml">
                <list string="Waves" decoration-info="state in ('draft', 'dispatched')" decoration-warning="state == 'in_progress'" decoration-success="state in ('completed', 'closed')" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="scheduled_date"/>
                    <field name="driver_id"/>
                    <field name="vehicle_id"/>
                    <field name="delivery_count"/>
                    <field name="delivered_count"/>
                    <field name="failed_count"/>
                    <field name="completion_pct" widget="percentage"/>
                    <field name="cod_expected" optional="show"/>
                    <field name="cod_collected" optional="show"/>
                    <field name="cod_outstanding" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_eh_log_last_mile_wave_form" model="ir.ui.view">
            <field name="name">eh.log.last.mile.wave.form</field>
            <field name="model">eh.log.last.mile.wave</field>
            <field name="arch" type="xml">
                <form string="Wave">
                    <header>
                        <button name="action_dispatch" string="Dispatch" type="object" class="btn-primary" invisible="state != 'draft'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_set_in_progress" string="In Progress" type="object" class="btn-primary" invisible="state != 'dispatched'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_complete" string="Complete" type="object" class="btn-primary" invisible="state != 'in_progress'" groups="eh_log_base.group_eh_log_user"/>
                        <button name="action_close" string="Close (cash up)" type="object" class="btn-primary" invisible="state != 'completed'" groups="eh_log_base.group_eh_log_manager"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('completed', 'closed', 'cancelled')" groups="eh_log_base.group_eh_log_manager"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,dispatched,in_progress,completed,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_deliveries" type="object" class="oe_stat_button" icon="fa-map-pin">
                                <field name="delivery_count" widget="statinfo" string="Stops"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Plan">
                                <field name="scheduled_date"/>
                                <field name="driver_id" options="{'no_create': True}"/>
                                <field name="vehicle_id" options="{'no_create': True}"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Timing">
                                <field name="departed_at" readonly="1"/>
                                <field name="completed_at" readonly="1"/>
                            </group>
                        </group>
                        <group string="Counters">
                            <group>
                                <field name="delivery_count" readonly="1"/>
                                <field name="delivered_count" readonly="1"/>
                                <field name="failed_count" readonly="1"/>
                                <field name="pending_count" readonly="1"/>
                                <field name="completion_pct" widget="percentage" readonly="1"/>
                            </group>
                            <group string="COD">
                                <field name="cod_expected" readonly="1"/>
                                <field name="cod_collected" readonly="1"/>
                                <field name="cod_outstanding" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Deliveries">
                                <field name="delivery_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="state"/>
                                        <field name="customer_id" options="{'no_create': True}"/>
                                        <field name="delivery_partner_id" options="{'no_create': True}"/>
                                        <field name="scheduled_window_start"/>
                                        <field name="scheduled_window_end"/>
                                        <field name="package_count"/>
                                        <field name="cod_amount"/>
                                        <field name="attempt_count"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_eh_log_last_mile_wave_kanban" model="ir.ui.view">
            <field name="name">eh.log.last.mile.wave.kanban</field>
            <field name="model">eh.log.last.mile.wave</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="scheduled_date"/>
                    <field name="driver_id"/>
                    <field name="delivery_count"/>
                    <field name="completion_pct"/>
                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_card_content">
                                <div class="o_kanban_record_top">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="scheduled_date"/>
                                    <div>Driver: <field name="driver_id"/></div>
                                    <div>Stops: <field name="delivery_count"/></div>
                                    <div>Done: <field name="completion_pct" widget="percentage"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_eh_log_last_mile_wave_search" model="ir.ui.view">
            <field name="name">eh.log.last.mile.wave.search</field>
            <field name="model">eh.log.last.mile.wave</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="driver_id"/>
                    <field name="vehicle_id"/>
                    <separator/>
                    <filter string="Open" name="filter_open" domain="[('state', 'in', ('draft', 'dispatched', 'in_progress'))]"/>
                    <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                    <filter string="With Outstanding COD" name="filter_cod_outstanding" domain="[('cod_outstanding', '&gt;', 0)]"/>
                    <filter string="Today" name="filter_today" domain="[('scheduled_date', '=', context_today())]"/>
                    <filter string="Group by Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Group by Date" name="group_date" context="{'group_by': 'scheduled_date'}"/>
                </search>
            </field>
        </record>

        <record id="action_eh_log_last_mile_wave" model="ir.actions.act_window">
            <field name="name">Waves</field>
            <field name="res_model">eh.log.last.mile.wave</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_eh_log_last_mile_wave_search"/>
        </record>

    </data>
</odoo>
