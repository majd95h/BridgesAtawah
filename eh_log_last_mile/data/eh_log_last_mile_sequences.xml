<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_log_last_mile_wave" model="ir.sequence">
            <field name="name">Last Mile Wave</field>
            <field name="code">eh.log.last.mile.wave</field>
            <field name="prefix">LMW/%(year)s/</field>
            <field name="padding">6</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_eh_log_last_mile_delivery" model="ir.sequence">
            <field name="name">Last Mile Delivery</field>
            <field name="code">eh.log.last.mile.delivery</field>
            <field name="prefix">LMD/%(year)s/</field>
            <field name="padding">8</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
