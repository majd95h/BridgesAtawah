    <!-- ===================== Actions ===================== -->
    <record id="action_shipping_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">shipping.product</field>
        <field name="view_mode">kanban,list,form</field>
        <!-- <field name="search_view_id" ref="view_shipping_product_search"/> -->
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ===================== Menu Items ===================== -->
    <menuitem id="menu_shipping_product" name="Products" parent="menu_shipping_content" 
              action="action_shipping_product" sequence="15"/>
