<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Products Tree View ===================== -->
    <record id="view_shipping_product_tree" model="ir.ui.view">
        <field name="name">shipping.product.tree</field>
        <field name="model">shipping.product</field>
        <field name="arch" type="xml">
            <list string="Products" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="sku"/>
                <field name="category"/>
                <field name="price" sum="Total Price"/>
                <field name="stock_quantity" sum="Total Stock"/>
                <field name="is_featured"/>
                <field name="is_active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ===================== Products Form View ===================== -->
    <record id="view_shipping_product_form" model="ir.ui.view">
        <field name="name">shipping.product.form</field>
        <field name="model">shipping.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Product Name"/>
                        </h1>
                    </div>

                    <notebook>
                        <!-- Basic Info Tab -->
                        <page string="Basic Information" name="basic_info">
                            <group>
                                <group>
                                    <field name="sku"/>
                                    <field name="category"/>
                                    <field name="origin"/>
                                    <field name="is_active"/>
                                    <field name="is_featured"/>
                                </group>
                                <group>
                                    <field name="price"/>
                                    <field name="cost"/>
                                    <field name="stock_quantity"/>
                                    <field name="lead_time"/>
                                </group>
                            </group>

                            <group string="Image" name="image_group">
                                <field name="image" widget="image" class="oe_avatar"/>
                            </group>

                            <group string="Description" name="description_group">
                                <field name="description" nolabel="1"/>
                            </group>
                        </page>

                        <!-- Details Tab -->
                        <page string="Details" name="details">
                            <group>
                                <field name="specs" nolabel="1" placeholder="Enter technical specifications..."/>
                            </group>
                        </page>

                        <!-- Reviews & Rating -->
                        <page string="Reviews &amp; Rating" name="reviews">
                            <group>
                                <group>
                                    <field name="rating"/>
                                    <field name="review_count"/>
                                </group>
                                <group>
                                    <field name="tags"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== Products Kanban View ===================== -->
    <record id="view_shipping_product_kanban" model="ir.ui.view">
    <field name="name">shipping.product.kanban</field>
    <field name="model">shipping.product</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column" quickCreate="false">
            <field name="id"/>
            <field name="name"/>
            <field name="price"/>
            <field name="stock_quantity"/>
            <field name="is_featured"/>
            <field name="rating"/>
            <templates>
                <t t-name="card">
                    <div class="o_kanban_card">
                        <div class="o_kanban_image">
                            <img t-att-src="kanban_image('shipping.product', 'image', record.id.raw_value)" alt="Product"/>
                        </div>
                        <div class="o_kanban_details">
                            <strong t-esc="record.name.value"/>
                            <p class="o_text_muted">
                                $<t t-esc="record.price.value"/>
                            </p>
                            <p>
                                Stock: <t t-esc="record.stock_quantity.value"/>
                            </p>
                            <div class="o_kanban_footer">
                                <span t-if="record.is_featured.raw_value" class="badge badge-info">Featured</span>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>
