<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Shop Page -->
    <record id="page_shop" model="website.page">
        <field name="name">Shop with Us</field>
        <field name="key">shipping_logistics_theme.page_shop</field>
        <field name="url">/shop</field>
        <field name="type">qweb</field>
        <field name="is_published" eval="True"/>
        <field name="website_id" ref="website.default_website"/>
        <field name="arch" type="xml">
            <t t-name="shipping_logistics_theme.page_shop">
                <t t-call="website.layout">
                    <t t-set="additional_title">Shop - Shipping &amp; Logistics</t>
                    <div id="wrap" class="oe_structure">
                        <t t-call="shipping_logistics_theme.s_shipping_shop"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Shop Menu Item -->
   
</odoo>
