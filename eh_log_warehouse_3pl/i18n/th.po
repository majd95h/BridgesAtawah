#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_facility.py:0
msgid ""
"[EHL-WHS-001] Facility code %(code)s must be alphanumeric or underscore "
"only."
msgstr ""
"[EHL-WHS-001] รหัสสถานที่ %(code)s "
"ต้องเป็นตัวอักษรและตัวเลขหรือขีดล่างเท่านั้น"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_zone.py:0
msgid ""
"[EHL-WHS-002] Zone code %(code)s must be alphanumeric or underscore only."
msgstr ""
"[EHL-WHS-002] รหัสโซน %(code)s ต้องเป็นตัวอักษรและตัวเลขหรือขีดล่างเท่านั้น"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_location.py:0
msgid ""
"[EHL-WHS-003] Location code %(code)s must be alphanumeric or underscore "
"only."
msgstr ""
"[EHL-WHS-003] รหัสตำแหน่ง %(code)s "
"ต้องเป็นตัวอักษรและตัวเลขหรือขีดล่างเท่านั้น"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_client.py:0
msgid ""
"[EHL-WHS-004] Billing day %(day)s must be between 1 and 28 so the cron fires"
" every month."
msgstr ""
"[EHL-WHS-004] วันเรียกเก็บเงิน %(day)s ต้องอยู่ระหว่าง 1 ถึง 28 เพื่อให้ "
"cron ทำงานทุกเดือน"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_client.py:0
msgid ""
"[EHL-WHS-005] Facility %(facility)s is not in client %(client)s's allowed "
"facilities list."
msgstr ""
"[EHL-WHS-005] สถานที่ %(facility)s ไม่อยู่ในรายการสถานที่ที่อนุญาตของลูกค้า "
"%(client)s"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_rate_card.py:0
msgid "[EHL-WHS-006] Rate line unit price cannot be negative."
msgstr "[EHL-WHS-006] ราคาต่อหน่วยของรายการอัตราต้องไม่เป็นค่าลบ"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_pick.py:0
msgid ""
"[EHL-WHS-007] Pick state must be changed via the action buttons, not by "
"direct write."
msgstr ""
"[EHL-WHS-007] ต้องเปลี่ยนสถานะการหยิบสินค้าผ่านปุ่มดำเนินการ "
"ไม่ใช่การเขียนโดยตรง"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_receipt.py:0
msgid ""
"[EHL-WHS-007] Receipt state must be changed via the action buttons, not by "
"direct write."
msgstr ""
"[EHL-WHS-007] ต้องเปลี่ยนสถานะการรับสินค้าผ่านปุ่มดำเนินการ "
"ไม่ใช่การเขียนโดยตรง"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_receipt.py:0
msgid "[EHL-WHS-008] Receipt %(name)s is %(state)s; lines are read-only."
msgstr ""
"[EHL-WHS-008] การรับสินค้า %(name)s อยู่ในสถานะ %(state)s "
"รายการเป็นแบบอ่านอย่างเดียว"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_pick.py:0
msgid "[EHL-WHS-009] Pick %(name)s is %(state)s; lines are read-only."
msgstr ""
"[EHL-WHS-009] การหยิบสินค้า %(name)s อยู่ในสถานะ %(state)s "
"รายการเป็นแบบอ่านอย่างเดียว"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_receipt.py:0
msgid ""
"[EHL-WHS-010] Receipt %(name)s has no lines; add lines before completing "
"put-away."
msgstr ""
"[EHL-WHS-010] การรับสินค้า %(name)s ไม่มีรายการ "
"กรุณาเพิ่มรายการก่อนดำเนินการจัดเก็บให้เสร็จสมบูรณ์"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_receipt.py:0
msgid ""
"[EHL-WHS-011] Receipt line for product %(product)s has no destination "
"location."
msgstr ""
"[EHL-WHS-011] รายการรับสินค้าสำหรับผลิตภัณฑ์ %(product)s ไม่มีตำแหน่งปลายทาง"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_pick.py:0
msgid "[EHL-WHS-012] Pick %(name)s has no lines."
msgstr "[EHL-WHS-012] การหยิบสินค้า %(name)s ไม่มีรายการ"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_pick.py:0
msgid "[EHL-WHS-013] Pick line for %(product)s has no source location."
msgstr "[EHL-WHS-013] รายการหยิบสินค้าสำหรับ %(product)s ไม่มีตำแหน่งต้นทาง"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_movement.py:0
msgid ""
"[EHL-WHS-014] Warehouse movements must be created through receipt put-away, "
"pick picking, transfer wizard, or adjustment workflow."
msgstr ""
"[EHL-WHS-014] "
"การเคลื่อนย้ายในคลังสินค้าต้องสร้างผ่านการจัดเก็บเมื่อรับสินค้า "
"การหยิบสินค้า ตัวช่วยการโอนย้าย หรือเวิร์กโฟลว์การปรับปรุง"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_movement.py:0
msgid ""
"[EHL-WHS-015] Movement field(s) %(fields)s are immutable after creation. "
"Post a reversing adjustment instead."
msgstr ""
"[EHL-WHS-015] ฟิลด์การเคลื่อนย้าย %(fields)s ไม่สามารถแก้ไขได้หลังจากสร้าง "
"กรุณาลงบัญชีการปรับปรุงแบบกลับรายการแทน"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_movement.py:0
msgid ""
"[EHL-WHS-016] Warehouse movements are append-only and cannot be deleted."
msgstr ""
"[EHL-WHS-016] "
"การเคลื่อนย้ายในคลังสินค้าเป็นแบบเพิ่มต่อท้ายเท่านั้นและไม่สามารถลบได้"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_snapshot.py:0
msgid ""
"[EHL-WHS-017] Snapshots are created by the daily cron or the explicit "
"rebuild action; direct ORM creates are blocked."
msgstr ""
"[EHL-WHS-017] สแนปช็อตถูกสร้างโดย cron รายวันหรือการดำเนินการสร้างใหม่โดยตรง"
" การสร้างผ่าน ORM โดยตรงจะถูกบล็อก"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_snapshot.py:0
msgid "[EHL-WHS-018] Snapshots are immutable."
msgstr "[EHL-WHS-018] สแนปช็อตไม่สามารถแก้ไขได้"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_snapshot.py:0
msgid ""
"[EHL-WHS-019] Snapshots are append-only; use the rebuild action for back-"
"fill."
msgstr ""
"[EHL-WHS-019] สแนปช็อตเป็นแบบเพิ่มต่อท้ายเท่านั้น "
"กรุณาใช้การดำเนินการสร้างใหม่สำหรับการเติมข้อมูลย้อนหลัง"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_billing_run.py:0
msgid ""
"[EHL-WHS-020] Billing run period start %(start)s is after period end "
"%(end)s."
msgstr ""
"[EHL-WHS-020] วันเริ่มต้นรอบการเรียกเก็บเงิน %(start)s อยู่หลังวันสิ้นสุดรอบ"
" %(end)s"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_billing_run.py:0
msgid "[EHL-WHS-021] Billing run %(name)s has no computed lines."
msgstr "[EHL-WHS-021] รอบการเรียกเก็บเงิน %(name)s ไม่มีรายการที่คำนวณแล้ว"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_billing_run.py:0
msgid "[EHL-WHS-022] Billing run state must change via the action buttons."
msgstr "[EHL-WHS-022] ต้องเปลี่ยนสถานะรอบการเรียกเก็บเงินผ่านปุ่มดำเนินการ"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_billing_run.py:0
msgid ""
"[EHL-WHS-023] Billing lines are created by the compute action; direct ORM "
"creates are blocked."
msgstr ""
"[EHL-WHS-023] รายการเรียกเก็บเงินถูกสร้างโดยการดำเนินการคำนวณ การสร้างผ่าน "
"ORM โดยตรงจะถูกบล็อก"

#. module: eh_log_warehouse_3pl
#. odoo-python
#: code:addons/eh_log_warehouse_3pl/models/eh_log_warehouse_billing_run.py:0
msgid ""
"[EHL-WHS-024] Billing lines can only be cleared by re-running the compute "
"action."
msgstr ""
"[EHL-WHS-024] "
"รายการเรียกเก็บเงินสามารถล้างได้เฉพาะโดยการเรียกใช้การดำเนินการคำนวณอีกครั้ง"

