<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_warehouse_location_list" model="ir.ui.view">
        <field name="name">eh.log.warehouse.location.list</field>
        <field name="model">eh.log.warehouse.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="full_code"/>
                <field name="zone_id"/>
                <field name="purpose"/>
                <field name="pallet_capacity"/>
                <field name="pallets_on_hand"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_warehouse_location_form" model="ir.ui.view">
        <field name="name">eh.log.warehouse.location.form</field>
        <field name="model">eh.log.warehouse.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="zone_id"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="full_code" readonly="1"/>
                        </group>
                        <group>
                            <field name="pallet_capacity"/>
                            <field name="pallets_on_hand" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_warehouse_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">eh.log.warehouse.location</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
