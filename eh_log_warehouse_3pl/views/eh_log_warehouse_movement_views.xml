<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_warehouse_movement_list" model="ir.ui.view">
        <field name="name">eh.log.warehouse.movement.list</field>
        <field name="model">eh.log.warehouse.movement</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="occurred_at"/>
                <field name="movement_type"/>
                <field name="client_id"/>
                <field name="facility_id"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="pallet_count"/>
                <field name="receipt_id" optional="hide"/>
                <field name="pick_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_warehouse_movement_form" model="ir.ui.view">
        <field name="name">eh.log.warehouse.movement.form</field>
        <field name="model">eh.log.warehouse.movement</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="movement_type"/>
                            <field name="client_id"/>
                            <field name="facility_id"/>
                            <field name="occurred_at"/>
                        </group>
                        <group>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="product_id"/>
                            <field name="lot_reference"/>
                            <field name="quantity"/>
                            <field name="pallet_count"/>
                        </group>
                    </group>
                    <group string="Operator Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_warehouse_movement" model="ir.actions.act_window">
        <field name="name">Movements</field>
        <field name="res_model">eh.log.warehouse.movement</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
