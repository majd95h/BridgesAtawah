<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_warehouse_facility_list" model="ir.ui.view">
        <field name="name">eh.log.warehouse.facility.list</field>
        <field name="model">eh.log.warehouse.facility</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="customs_status"/>
                <field name="zone_count"/>
                <field name="location_count"/>
                <field name="total_pallet_capacity"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_warehouse_facility_form" model="ir.ui.view">
        <field name="name">eh.log.warehouse.facility.form</field>
        <field name="model">eh.log.warehouse.facility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_zones"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-th">
                            <field name="zone_count" widget="statinfo" string="Zones"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="customs_status"/>
                            <field name="address_id"/>
                        </group>
                        <group>
                            <field name="total_pallet_capacity"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Zones" name="zones">
                            <field name="zone_ids">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="purpose"/>
                                    <field name="location_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eh_log_warehouse_facility" model="ir.actions.act_window">
        <field name="name">Facilities</field>
        <field name="res_model">eh.log.warehouse.facility</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
