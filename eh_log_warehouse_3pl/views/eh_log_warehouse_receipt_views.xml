<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_warehouse_receipt_list" model="ir.ui.view">
        <field name="name">eh.log.warehouse.receipt.list</field>
        <field name="model">eh.log.warehouse.receipt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="client_id"/>
                <field name="facility_id"/>
                <field name="supplier_id"/>
                <field name="expected_date"/>
                <field name="pallet_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_warehouse_receipt_form" model="ir.ui.view">
        <field name="name">eh.log.warehouse.receipt.form</field>
        <field name="model">eh.log.warehouse.receipt</field>
        <field name="arch" type="xml">
            <form string="Receipt">
                <header>
                    <button name="action_mark_arrived" string="Mark Arrived" type="object" class="btn-primary" invisible="state != 'expected'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_start_inspection" string="Start Inspection" type="object" class="btn-primary" invisible="state != 'arrived'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_complete_putaway" string="Complete Putaway" type="object" class="btn-primary" invisible="state != 'inspecting'" groups="eh_log_base.group_eh_log_user"/>
                    <button name="action_close" string="Close" type="object" class="btn-secondary" invisible="state != 'putaway'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('closed', 'cancelled')" groups="eh_log_base.group_eh_log_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="expected,arrived,inspecting,putaway,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Parties">
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="facility_id" options="{'no_create': True}"/>
                            <field name="supplier_id"/>
                            <field name="supplier_reference"/>
                        </group>
                        <group string="Schedule">
                            <field name="expected_date"/>
                            <field name="arrived_at" readonly="1"/>
                            <field name="putaway_at" readonly="1"/>
                            <field name="closed_at" readonly="1"/>
                            <field name="freight_job_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="lot_reference"/>
                                    <field name="expiry_date"/>
                                    <field name="quantity"/>
                                    <field name="pallet_count"/>
                                    <field name="destination_location_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_eh_log_warehouse_receipt_search" model="ir.ui.view">
        <field name="name">eh.log.warehouse.receipt.search</field>
        <field name="model">eh.log.warehouse.receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="client_id"/>
                <field name="facility_id"/>
                <field name="supplier_id"/>
                <field name="supplier_reference"/>
                <filter name="filter_expected" string="Expected" domain="[('state', '=', 'expected')]"/>
                <filter name="filter_arrived" string="Arrived" domain="[('state', '=', 'arrived')]"/>
                <filter name="filter_inspecting" string="Inspecting" domain="[('state', '=', 'inspecting')]"/>
                <filter name="filter_putaway" string="Putaway" domain="[('state', '=', 'putaway')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter name="group_by_client" string="Client" context="{'group_by': 'client_id'}"/>
                    <filter name="group_by_facility" string="Facility" context="{'group_by': 'facility_id'}"/>
                    <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eh_log_warehouse_receipt" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">eh.log.warehouse.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
