<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_warehouse_rate_card_list" model="ir.ui.view">
        <field name="name">eh.log.warehouse.rate.card.list</field>
        <field name="model">eh.log.warehouse.rate.card</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="currency_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_warehouse_rate_card_form" model="ir.ui.view">
        <field name="name">eh.log.warehouse.rate.card.form</field>
        <field name="model">eh.log.warehouse.rate.card</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="service_type"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="unit_price"/>
                                    <field name="minimum_quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_log_warehouse_rate_card" model="ir.actions.act_window">
        <field name="name">Rate Cards</field>
        <field name="res_model">eh.log.warehouse.rate.card</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
