<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_log_warehouse_billing_run_list" model="ir.ui.view">
        <field name="name">eh.log.warehouse.billing.run.list</field>
        <field name="model">eh.log.warehouse.billing.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="client_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_eh_log_warehouse_billing_run_form" model="ir.ui.view">
        <field name="name">eh.log.warehouse.billing.run.form</field>
        <field name="model">eh.log.warehouse.billing.run</field>
        <field name="arch" type="xml">
            <form string="Billing Run">
                <header>
                    <button name="action_compute" string="Compute Charges" type="object" class="btn-primary" invisible="state != 'draft'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_post" string="Post to Sale Order" type="object" class="btn-primary" invisible="state != 'computed'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state != 'computed'" groups="eh_log_base.group_eh_log_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" invisible="state in ('posted', 'cancelled')" groups="eh_log_base.group_eh_log_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="rate_card_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="total" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids" readonly="state != 'computed'">
                                <list>
                                    <field name="service_type"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eh_log_warehouse_billing_run" model="ir.actions.act_window">
        <field name="name">Billing Runs</field>
        <field name="res_model">eh.log.warehouse.billing.run</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[(False, 'list'), (False, 'form')]"/>
    </record>

</odoo>
