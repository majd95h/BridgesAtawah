<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <data>

        <record id="cron_capture_daily_snapshot" model="ir.cron">
            <field name="name">Warehouse: Capture Daily On-Hand Snapshot</field>
            <field name="model_id" ref="model_eh_log_warehouse_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.cron_capture_daily_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_run_monthly_billing" model="ir.cron">
            <field name="name">Warehouse: Run Monthly Billing</field>
            <field name="model_id" ref="model_eh_log_warehouse_billing_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_monthly_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
